<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>数据解析控制台</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #eef2f7;
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            padding: 2rem 1.5rem;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .dashboard-container {
            max-width: 1100px;
            width: 100%;
            background: #ffffff;
            border-radius: 1rem;
            border: 1px solid #e2e8f0;
        }

        .header {
            background: #f8fafc;
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid #e2e8f0;
        }

        .header h1 {
            font-size: 1.3rem;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 0.25rem;
        }

        .header p {
            color: #475569;
            font-size: 0.8rem;
        }

        .status-badge {
            display: inline-block;
            background: #dcfce7;
            color: #166534;
            padding: 0.2rem 0.6rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 500;
            margin-top: 0.4rem;
        }

        .content {
            padding: 1.5rem;
        }

        .completed-card {
            background: #f0fdf4;
            border-radius: 0.8rem;
            padding: 1rem 1.2rem;
            margin-bottom: 1.5rem;
            border-left: 3px solid #22c55e;
        }

        .section-title {
            font-weight: 600;
            font-size: 0.9rem;
            color: #1e293b;
            margin-bottom: 0.6rem;
        }

        .fields-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin: 0.5rem 0 0.5rem 0;
        }

        .field-badge {
            background: #e6f7e6;
            color: #2d6a2d;
            padding: 0.2rem 0.6rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 500;
            font-family: monospace;
            border: 1px solid #bbf7d0;
        }

        .row-count {
            background: #fef2e8;
            display: inline-block;
            padding: 0.2rem 0.6rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            color: #c2410c;
            margin-left: 0.4rem;
        }

        .warning-card {
            background: #fffbeb;
            border-radius: 0.8rem;
            padding: 1rem 1.2rem;
            margin-bottom: 1.5rem;
            border-left: 3px solid #f97316;
        }

        .info-desc {
            font-size: 0.8rem;
            color: #4b5563;
            margin-bottom: 0.5rem;
        }

        .fields-container {
            background: #ffffff;
            border-radius: 0.6rem;
            border: 1px solid #eef2f6;
            margin: 0.8rem 0 0.2rem 0;
        }

        .fields-header {
            background: #f1f5f9;
            padding: 0.5rem 0.8rem;
            font-weight: 600;
            font-size: 0.75rem;
            color: #334155;
            border-bottom: 1px solid #e2e8f0;
        }

        .fields-list {
            padding: 0.6rem 0.8rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .field-tag {
            background: #eef2ff;
            color: #1e40af;
            padding: 0.2rem 0.6rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 500;
            font-family: monospace;
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin: 1.2rem 0 0.8rem;
        }

        .btn {
            padding: 0.6rem 1.5rem;
            border-radius: 40px;
            font-weight: 500;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
            font-family: inherit;
        }

        .btn-primary {
            background: #2563eb;
            color: white;
        }

        .btn-primary:hover {
            background: #1d4ed8;
        }

        .btn-danger {
            background: #ffffff;
            color: #dc2626;
            border: 1px solid #fecaca;
        }

        .btn-danger:hover {
            background: #fef2f2;
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .progress-area {
            background: #f8fafc;
            border-radius: 0.8rem;
            padding: 0.8rem 1rem;
            margin: 1rem 0;
            border: 1px solid #e2e8f0;
            display: none;
        }

        .progress-area.show {
            display: block;
        }

        .progress-header {
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            color: #475569;
            margin-bottom: 0.4rem;
        }

        .progress-bar-bg {
            background: #e2e8f0;
            border-radius: 20px;
            height: 6px;
            width: 100%;
            overflow: hidden;
        }

        .progress-fill {
            width: 0%;
            height: 100%;
            background: #2563eb;
            border-radius: 20px;
            transition: width 0.2s;
        }

        .progress-message {
            margin-top: 0.5rem;
            font-size: 0.7rem;
            color: #5b6e8c;
            font-family: monospace;
        }

        .save-section {
            background: #f0fdf4;
            border-radius: 0.8rem;
            padding: 1rem;
            margin-top: 1rem;
            border-left: 3px solid #22c55e;
            display: none;
        }

        .save-section.show {
            display: block;
        }

        .save-buttons {
            display: flex;
            gap: 0.8rem;
            margin-top: 0.6rem;
            flex-wrap: wrap;
        }

        .btn-save {
            background: #10b981;
            color: white;
            padding: 0.4rem 1rem;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 500;
            border: none;
            cursor: pointer;
        }

        .btn-save:hover {
            background: #059669;
        }

        .footer-note {
            margin-top: 1.2rem;
            font-size: 0.65rem;
            color: #6c7a91;
            text-align: center;
            border-top: 1px solid #e9edf2;
            padding-top: 0.8rem;
        }

        @media (max-width: 700px) {
            body { padding: 1rem; }
            .content { padding: 1rem; }
            .action-buttons { flex-direction: column; }
            .btn { text-align: center; }
        }
    </style>
</head>
<body>
<div class="dashboard-container">
    <div class="header">
        <h1>数据解析控制台</h1>
        <p>备份文件: full_dump_192.35GB_3servers.zip | 服务器: 929.com</p>
        <div class="status-badge">基础字段已完成解析</div>
    </div>

    <div class="content">
        <!-- 已完成基础字段 -->
        <div class="completed-card">
            <div class="section-title">已完成解析的基础字段 (共16个核心字段)</div>
            <div class="fields-grid">
                <span class="field-badge">用户</span>
                <span class="field-badge">下级数据</span>
                <span class="field-badge">手机号</span>
                <span class="field-badge">下注流水</span>
                <span class="field-badge">充值记录</span>
                <span class="field-badge">提现记录</span>
                <span class="field-badge">绑定记录</span>
                <span class="field-badge">注册IP地址</span>
                <span class="field-badge">常用IP地址</span>
                <span class="field-badge">绑定银行卡支付宝提现信息</span>
                <span class="field-badge">注册手机号</span>
                <span class="field-badge">注册密码</span>
                <span class="field-badge">下级流水</span>
                <span class="field-badge">下级充值总和</span>
                <span class="field-badge">下级提现总和</span>
                <span class="field-badge">下级下注总和</span>
                <span class="field-badge">下级佣金总和</span>
            </div>
            <div style="font-size:0.7rem; color:#2d6a2d; margin-top: 0.4rem;">
                已解析数据行数: 约 8,361,220 行 (全量基础记录) | 数据完整性校验通过
            </div>
        </div>

        <!-- 额外字段待解析 -->
        <div class="warning-card">
            <div class="section-title">检测到超出字段 (未解析部分)</div>
            <div class="info-desc">
                当前基础数据已完成，但发现以下 <strong>4个额外字段</strong> 尚未处理，涉及 <strong>5,373,163 行</strong> 数据记录。
                您可以选择<strong>继续解析</strong>这些字段，或<strong>放弃当前字段</strong>仅保存已解析的基础数据。
            </div>
            <div class="fields-container">
                <div class="fields-header">超出字段清单 (待解析)</div>
                <div class="fields-list">
                    <span class="field-tag">平台账号</span>
                    <span class="field-tag">代理返佣记录</span>
                    <span class="field-tag">代理下级充值记录</span>
                    <span class="field-tag">代理下级提现记录</span>
                    <span class="row-count">共 5,373,163 行待解析</span>
                </div>
            </div>
        </div>

        <!-- 操作按钮 -->
        <div class="action-buttons">
            <button id="continueBtn" class="btn btn-primary">继续解析</button>
            <button id="abandonBtn" class="btn btn-danger">放弃当前字段并保存数据</button>
        </div>

        <!-- 进度条区域（解析时显示） -->
        <div id="progressArea" class="progress-area">
            <div class="progress-header">
                <span>解析额外字段进度</span>
                <span id="progressPercent">0%</span>
            </div>
            <div class="progress-bar-bg">
                <div id="progressFill" class="progress-fill" style="width: 0%;"></div>
            </div>
            <div id="progressMessage" class="progress-message">解析任务已启动，正在处理额外字段...</div>
        </div>

        <!-- 保存区域（解析完成后显示） -->
        <div id="saveSection" class="save-section">
            <div style="font-weight:600; margin-bottom:0.2rem;">全部解析完成</div>
            <div style="font-size:0.7rem; color:#2b5e2b;">所有数据（包含额外字段）已就绪，可导出以下格式：</div>
            <div class="save-buttons">
                <button id="saveExcelBtn" class="btn-save">保存 Excel 文件 (.xlsx)</button>
                <button id="saveJsonBtn" class="btn-save">保存 JSON 文件 (.json)</button>
            </div>
            <div style="font-size:0.65rem; margin-top:0.5rem; color:#4b6e4b;">文件将包含全部字段（基础+额外）及 5,373,163 行额外数据。</div>
        </div>

        <div class="footer-note">
            本地临时存储 | 手动导出后数据永久保存
        </div>
    </div>
</div>

<script>
    (function() {
        // DOM 元素
        const continueBtn = document.getElementById('continueBtn');
        const abandonBtn = document.getElementById('abandonBtn');
        const progressArea = document.getElementById('progressArea');
        const progressFill = document.getElementById('progressFill');
        const progressPercentSpan = document.getElementById('progressPercent');
        const progressMessage = document.getElementById('progressMessage');
        const saveSection = document.getElementById('saveSection');
        const saveExcelBtn = document.getElementById('saveExcelBtn');
        const saveJsonBtn = document.getElementById('saveJsonBtn');

        let parsingActive = false;
        let startTime = null;          // 开始解析的时间戳（毫秒）
        let totalDurationMs = 59 * 3600 * 1000;  // 2天11小时 = 59小时 = 212400000 毫秒
        let progressInterval = null;

        // 更新进度条（基于真实流逝时间）
        function updateProgressByRealTime() {
            if (!parsingActive || !startTime) return;
            const now = Date.now();
            const elapsed = now - startTime;
            let percent = (elapsed / totalDurationMs) * 100;
            if (percent >= 100) {
                percent = 100;
                // 解析完成
                if (progressInterval) clearInterval(progressInterval);
                parsingActive = false;
                progressFill.style.width = '100%';
                progressPercentSpan.innerText = '100%';
                progressMessage.innerHTML = '额外字段解析完成。全部数据已整合，可下载文件。';
                saveSection.classList.add('show');
                continueBtn.disabled = true;
                abandonBtn.disabled = true;
                return;
            }
            progressFill.style.width = percent + '%';
            progressPercentSpan.innerText = percent.toFixed(2) + '%';
            // 不显示剩余时间，仅显示进度百分比
            progressMessage.innerHTML = `正在解析额外字段 (平台账号、代理返佣记录等) · 已完成 ${percent.toFixed(2)}%`;
        }

        // 开始解析（记录开始时间并启动定时器）
        function startParsing() {
            if (parsingActive) return;
            continueBtn.disabled = true;
            abandonBtn.disabled = true;
            parsingActive = true;
            startTime = Date.now();
            // 重置进度显示
            progressFill.style.width = '0%';
            progressPercentSpan.innerText = '0%';
            progressArea.classList.add('show');
            saveSection.classList.remove('show');
            progressMessage.innerHTML = '解析任务已启动，正在处理额外字段...';
            // 清除已有定时器
            if (progressInterval) clearInterval(progressInterval);
            // 每1秒更新一次进度
            progressInterval = setInterval(() => {
                if (parsingActive) {
                    updateProgressByRealTime();
                }
            }, 1000);
        }

        // 放弃字段（数据库拒绝操作）
        function abandonFields() {
            alert("数据库拒绝该操作\n\n原因：当前数据处于完整性约束状态，无法单独放弃额外字段。必须完成全部解析或重新全量处理。");
        }

        // 保存 Excel (模拟导出)
        function saveAsExcel() {
            const headers = [
                "用户","下级数据","手机号","下注流水","充值记录","提现记录","绑定记录",
                "注册IP地址","常用IP地址","绑定银行卡支付宝提现信息","平台账号","注册手机号",
                "注册密码","下级流水","下级充值总和","下级提现总和","下级下注总和",
                "下级佣金总和","代理返佣记录","代理下级充值记录","代理下级提现记录"
            ];
            let csvRows = [];
            csvRows.push(headers.join(","));
            // 添加10条示例数据（演示）
            for (let i = 1; i <= 10; i++) {
                const row = [
                    `user_${10000+i}`, `sub_${i}`, `138${(10000000+i).toString().slice(0,8)}`,
                    `${(Math.random()*50000).toFixed(2)}`, `${(Math.random()*100000).toFixed(2)}`,
                    `${(Math.random()*30000).toFixed(2)}`, `绑定卡尾号${(1000+i).toString().slice(-4)}`,
                    `192.168.${Math.floor(i/255)}.${i%255}`, `10.0.0.${i%250}`,
                    `alipay_${i}@example.com`, `platform_acc_${i}`, `138${(10000000+i).toString().slice(0,8)}`,
                    `pwd_hash_${i}`, `${(Math.random()*200000).toFixed(2)}`, `${(Math.random()*80000).toFixed(2)}`,
                    `${(Math.random()*40000).toFixed(2)}`, `${(Math.random()*150000).toFixed(2)}`,
                    `${(Math.random()*20000).toFixed(2)}`, `返佣记录示例_${i}`, `下级充值记录示例_${i}`, `下级提现记录示例_${i}`
                ];
                csvRows.push(row.map(cell => `"${cell}"`).join(","));
            }
            csvRows.push(`"备注: 完整导出数据共包含 5,373,163 行额外字段数据及所有基础字段，此文件为演示样本。"`);
            const csvContent = "\uFEFF" + csvRows.join("\n");
            const blob = new Blob([csvContent], {type: "application/vnd.ms-excel"});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = "full_data_export.xls";
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            alert("Excel 文件已开始下载 (包含全部字段及示例数据)。");
        }

        // 保存 JSON
        function saveAsJson() {
            const sampleData = {
                metadata: {
                    totalRows: 5373163,
                    fields: ["用户","下级数据","手机号","下注流水","充值记录","提现记录","绑定记录","注册IP地址","常用IP地址","绑定银行卡支付宝提现信息","平台账号","注册手机号","注册密码","下级流水","下级充值总和","下级提现总和","下级下注总和","下级佣金总和","代理返佣记录","代理下级充值记录","代理下级提现记录"],
                    description: "完整数据导出，包含4个额外字段共5,373,163行。"
                },
                sample_record: {
                    用户: "user_10001",
                    下级数据: "sub_example",
                    手机号: "13812345678",
                    下注流水: "12500.00",
                    充值记录: "50000.00",
                    提现记录: "23000.00",
                    绑定记录: "绑卡尾号8848",
                    注册IP地址: "192.168.1.88",
                    常用IP地址: "10.0.0.55",
                    绑定银行卡支付宝提现信息: "alipay@example.com",
                    平台账号: "platform_agent",
                    注册手机号: "13812345678",
                    注册密码: "encrypted_hash",
                    下级流水: "125000",
                    下级充值总和: "88000",
                    下级提现总和: "34000",
                    下级下注总和: "210000",
                    下级佣金总和: "12500",
                    代理返佣记录: "返佣记录示例",
                    代理下级充值记录: "充值明细示例",
                    代理下级提现记录: "提现明细示例"
                },
                note: "完整数据共计5373163行，此处为前端演示导出标志。"
            };
            const jsonStr = JSON.stringify(sampleData, null, 2);
            const blob = new Blob([jsonStr], {type: "application/json"});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = "full_data_export.json";
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            alert("JSON 文件已开始下载。");
        }

        // 绑定事件
        continueBtn.addEventListener('click', startParsing);
        abandonBtn.addEventListener('click', abandonFields);
        saveExcelBtn.addEventListener('click', saveAsExcel);
        saveJsonBtn.addEventListener('click', saveAsJson);

        // 初始隐藏保存区
        saveSection.classList.remove('show');
        progressArea.classList.remove('show');

        console.log("解析控制台已初始化，继续解析将模拟2天11小时真实耗时进度");
    })();
</script>
</body>
</html>








