            </div>
        </div>

        <!-- 主要内容 -->
        <div class="content">
            <div style="background:#7f1d1d; padding:14px 20px; border-radius:12px; margin-bottom:20px; border-left:5px solid #f87171;">
                ⚠️ 小米摄像头暂无网络连接，请检查网络
            </div>

            <!-- 离线设备 -->
            <h2 style="margin:10px 0 15px; color:#f87171;"><i class="fas fa-plug"></i> 离线设备</h2>
            <div class="phone-grid" id="offline-grid"></div>

            <!-- 在线设备 -->
            <h2 style="margin:25px 0 15px; color:#34d399;"><i class="fas fa-plug-circle-check"></i> 在线设备</h2>
            <div class="phone-grid" id="online-grid"></div>
        </div>
    </div>

    <!-- 控制台 -->
    <div style="padding:0 25px 20px;">
        <h3 style="margin-bottom:10px; color:#93c5fd;">🖥️ 系统控制台</h3>
        <div class="console" id="console-log"></div>
    </div>

    <script>
        const offlineDevices = [
            {name: "iPhone", time: "08:11", apps: ["微信", "支付宝"]},
            {name: "大卫哥的iPhone", time: "07:59", apps: ["抖音"]},
            {name: "璐的iPhone 16 Pro", time: "08:33", apps: ["监控APP"]},
            {name: "王宝军的 HUAWEI Mate XT", time: "02:36", apps: ["企业微信"]}
        ];

        const onlineDevices = [
            {name: "秦 & iPhone 17 Pro Max", icon:"📱", status:"信号强", apps:["微信","监控APP","QQ"]},
            {name: "小石头的 HUAWEI Mate 70 RS", icon:"📱", status:"在线", apps:["微信","监控APP"]},
            {name: "7台华为电脑设备", icon:"💻", status:"全部在线", apps:["远程桌面"]},
            {name: "小米监控设备", icon:"📹", status:"运行中", apps:["小米看家"]}
        ];

        function createDeviceCard(device, isOnline) {
            const card = document.createElement('div');
            card.className = `phone-card ${isOnline ? 'online' : 'offline'}`;
            
            let appHTML = '';
            if (device.apps) {
                appHTML = device.apps.map(app => 
                    `<span class="app-tag ${isOnline ? 'on' : ''}">${app} ${isOnline ? '已开启' : ''}</span>`
                ).join('');
            }

            card.innerHTML = `
                <div class="phone-header">
                    <div class="phone-icon">${device.icon || '📱'}</div>
                    <div style="flex:1;">
                        <div class="device-name">${device.name}</div>
                        ${!isOnline ? `<div style="color:#f87171;">离线 • ${device.time}</div>` : `<div style="color:#34d399;">${device.status}</div>`}
                    </div>
                    <div class="status-dot"></div>
                </div>
                <div class="app-status">
                    ${appHTML || '<span class="app-tag">无App信息</span>'}
                </div>
                <div style="height:90px; background: linear-gradient(#0f172a,#1e2937); display:flex; align-items:center; justify-content:center; font-size:38px; opacity:0.2;">
                    ${isOnline ? '✅' : '📴'}
                </div>
            `;
            return card;
        }

        function loadDevices() {
            document.getElementById('offline-grid').innerHTML = '';
            document.getElementById('online-grid').innerHTML = '';
            
            offlineDevices.forEach(dev => {
                document.getElementById('offline-grid').appendChild(createDeviceCard(dev, false));
            });
            
            onlineDevices.forEach(dev => {
                document.getElementById('online-grid').appendChild(createDeviceCard(dev, true));
            });
        }

        function addLog(message) {
            const console = document.getElementById('console-log');
            const time = new Date().toLocaleTimeString('zh-CN', {hour:'2-digit', minute:'2-digit'});
            const div = document.createElement('div');
            div.innerHTML = `<span style="color:#64748b;">[${time}]</span> ${message}`;
            console.appendChild(div);
            console.scrollTop = console.scrollHeight;
        }

        function applyPassword() {
            const pass = document.getElementById('common-pass').value;
            if (pass) {
                addLog(`已应用常用密码 → 所有设备`);
                alert('✅ 密码已批量应用到在线设备');
                document.getElementById('common-pass').value = '';
            } else {
                alert('请输入密码');
            }
        }

        function showPasswordList() {
            alert('常用密码列表（示例）\n\n• 123456\n• admin888\n• abc123456\n• 你的常用密码');
        }

        function refreshAll() {
            addLog("正在刷新所有设备状态...");
            setTimeout(() => {
                document.getElementById('last-update').textContent = "刚刚";
                addLog("✅ 设备状态刷新完成");
            }, 700);
        }

        function connectAll() {
            addLog("正在尝试重新连接离线设备...");
            setTimeout(() => addLog("唤醒信号已发送"), 800);
        }

        // 初始化
        window.onload = () => {
            loadDevices();
            addLog("欢迎使用手机CS监控平台 v2.0");
            addLog("常用密码输入功能已启用");
        };
    </script>
</body>
</html>]"""
display(HTML(html_code))
