</head>
<body>
    <div class="header">
        <div class="title">
            <i class="fas fa-mobile-alt"></i>
            手机CS监控一览表
        </div>
        <div>最后更新: <span id="last-update">刚刚</span></div>
    </div>

    <!-- 控制面板 + 密码输入 -->
    <div class="control-panel">
        <button class="btn btn-primary" onclick="refreshAll()"><i class="fas fa-sync"></i> 刷新全部</button>
        <button class="btn btn-success" onclick="connectAll()"><i class="fas fa-plug"></i> 全部重连</button>
        
        <!-- 常用密码快速输入 -->
        <div class="password-panel">
            <strong><i class="fas fa-key"></i> 常用密码：</strong>
            <input type="password" id="common-pass" placeholder="输入常用密码" style="padding:8px 12px; border-radius:8px; border:none; width:180px;">
            <button class="btn btn-primary" onclick="applyPassword()">应用密码</button>
            <button class="btn" style="background:#64748b;" onclick="showPasswordList()">常用密码列表</button>
        </div>
    </div>

    <div class="main">
        <!-- 侧边栏 -->
        <div class="sidebar">
            <h3 style="margin-bottom:15px; color:#93c5fd;">📊 系统概览</h3>
            <div style="background:#1e2937; padding:15px; border-radius:12px; margin-bottom:20px;">
                <div style="color:#34d399; font-size:2.2rem; font-weight:700;">4 <span style="font-size:1rem;">在线</span></div>
