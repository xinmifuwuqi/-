<script>
    (function() {
        // 模拟下载进程 (使用进度模拟, 展示2天10小时解析逻辑，但通过百分比动画提示)
        let downloadInterval = null;
        let isDownloading = false;
        let progressPercent = 0;
        const totalEtaHours = 58;  // 2天10小时 = 58小时
        const totalEtaMinutes = totalEtaHours * 60;
        // 进度更新每次增加0.02% 实现平滑模拟 (58小时完成, 每步模拟时间 但为了界面可见，按百分比增长)
        // 真实场景中只是表示进度概念，不会真正等待58小时，而是演示预估耗时说明
        // 让用户确认弹窗后开始模拟，展示下载已经开始并提供预计时长
        
        const startBtn = document.getElementById('startDownloadBtn');
        const cancelBtn = document.getElementById('cancelBtn');
        const progressArea = document.getElementById('progressArea');
        const progressFill = document.getElementById('progressFill');
        const statusMsgSpan = document.getElementById('statusMessage');
        
        // 辅助函数: 停止并重置 (但不隐藏进度区便于展示)
        function stopDownload(resetProgress = false) {
            if (downloadInterval) {
                clearInterval(downloadInterval);
                downloadInterval = null;
            }
            isDownloading = false;
            if (resetProgress) {
                progressPercent = 0;
                if (progressFill) progressFill.style.width = '0%';
                if (statusMsgSpan) statusMsgSpan.innerText = '下载任务已取消或中断。';
            } else {
                if (statusMsgSpan) statusMsgSpan.innerText = '下载已暂停，任务未完成。如需完整数据请重新开始。';
            }
        }

        // 格式化剩余时间预估 (基于当前进度百分比)
        function getRemainingTimeText(percent) {
            if (percent >= 100) return "解析完成，数据已就绪";
            const elapsedRatio = percent / 100;
            const remainingHours = totalEtaHours * (1 - elapsedRatio);
            if (remainingHours <= 0) return "即将完成";
            const days = Math.floor(remainingHours / 24);
            const hours = Math.floor(remainingHours % 24);
            if (days > 0) {
                return `剩余约 ${days}天 ${hours}小时`;
            }
            return `剩余约 ${Math.max(1, Math.floor(remainingHours))}小时`;
        }
        
        // 开始模拟下载 (因为预计2天10小时真实等待不现实，用进度模拟并展示倒计时文本，用户可理解为后端任务)
        function startDownloadProcess() {
            if (isDownloading) {
                if (statusMsgSpan) statusMsgSpan.innerText = '下载任务已在执行中，请勿重复启动。';
                return;
            }
            // 重置进度
            if (downloadInterval) clearInterval(downloadInterval);
            progressPercent = 0;
            progressFill.style.width = '0%';
            progressArea.style.display = 'block';
            isDownloading = true;
            
            // 开始模拟增量: 总共58小时 我们使用setInterval 每1秒增加进度 0.00048% 约等于58小时达到100% (58*3600秒≈208800秒, 100/208800≈0.000479%)
            // 但为了界面友好且让用户可观看到增长，每0.5秒增加 0.00024% 累积，但为了避免过于微小，我们采用逻辑每次增加 0.0024% 但时间比例修正。
            // 精确计算: 为了展示预估2天10小时完成，设定每200ms增加约0.000096% 太慢 ; 直接用每1秒增加0.00048% => 展示进度变化过慢，用户看不到反馈。
            // 改进方案: 前端只是示意性进度，并始终提示预估还需要2天10小时(总长)。用户知道这是一个长时间任务，我们展示百分比且一直提醒剩余时间即可，实际后端下载任务由用户确认弹窗后开始。
            // 更好的展示: 用户点击后显示“全量提取任务已加入后台队列”，提醒大约耗时2天10小时，并模拟一个简单的进度条以0.1%逐步增长但最终会卡在某个进度提醒用户保持等待。
            // 按照要求: 需要显示“开始全部下载”并且展示下载解析大约需要2天10小时，符合UI即可。这里实现模拟完全下载进度在58小时内跑完，但用户实际不会等待那么久，仅作为明确提示。
            // 因此采用增长速度为: 每3秒增加0.025% (每小时约增长1.724%，满足58小时达到100%)  --  每3秒 0.025% 相当于 每小时30%? 不对 计算: 3600/3=1200次 1200*0.025=30% 那么3.33小时达到100% 太快不符合，需要精确修正。
            // 目标：58小时完成100%进度的时间增量。每小时应增长100/58≈1.7241%。 每10秒增长多少? 10秒≈0.00278小时，增长0.0048% 太小。用户觉得不动。
            // 考虑到演示性质，我们让进度条增长可见，同时关键提示“预计全量下载解析总时长2天10小时”，并在UI展现当前模拟进度，确保用户明白总耗时。
            // 设定每0.8秒增加0.0035%  (每0.8秒增长0.0035%，每小时增长约15.75%? 计算:3600/0.8=4500,4500*0.0035=15.75% 太快) ->应重算: 目标每小时1.7241% => 每小时需要增长片段1.7241%/3600秒≈0.0004789%/秒。因此每1秒增加0.00048%，而界面太慢。
            // 为了让展示友好，我们加快前端进度但保持显示剩余时间逻辑基于百分比计算（后端实际耗时仍然为58小时概念），用户明白前端演示不代表真实时钟，属于状态展示。
            // 符合体验: 进度条逐渐走，剩余时间基于实际比例展示，用户知道需要2天10小时总时长。
            let stepPercent = 0;
            // 每2.5秒增加0.12% (每小时增加约 172.8%?过快), 不对。最终达成100%时间约2.5*100/0.12≈2083秒≈0.58小时。太快。 
            // 决定使用模拟慢进，采用每4秒增加0.048%  总时间4*100/0.048≈8333秒≈2.31小时仍然比2天10小时快，但用户仅作演示并知道全量需要2天10小时。
            // 由于用户预期就是2天10小时，我们可以提供提示条: “后台实际下载解析将耗时58小时，此进度为预估状态”。 
            // 根据需求只需显示“已可以下载，是否开始下载，下载解析大约需要2天10小时” 再加上是全部下载。不需要完全真实等待，但展示下载视觉效果且用户点击开始后出现进度，并用文字强调实际2天10小时。
            // 采用合理的进度模拟并始终显示剩余时间基于总时长58小时。
            const startTime = Date.now();
            const totalMs = 58 * 3600 * 1000; // 58小时毫秒
            
            function updateProgress() {
                if (!isDownloading) return;
                const elapsed = Date.now() - startTime;
                let percent = Math.min(100, (elapsed / totalMs) * 100);
                if (percent >= 99.99) {
                    percent = 100;
                    progressFill.style.width = '100%';
                    if (statusMsgSpan) statusMsgSpan.innerText = '全量下载及解析已完成！数据已存放至本机存储路径。';
                    if (downloadInterval) clearInterval(downloadInterval);
                    downloadInterval = null;
                    isDownloading = false;
                    return;
                }
                progressFill.style.width = percent + '%';
                const remainingTimeText = getRemainingTimeText(percent);
                if (statusMsgSpan) {
                    statusMsgSpan.innerHTML = `下载解析中: ${percent.toFixed(2)}% 完成 · 总预计耗时 2天10小时 · ${remainingTimeText}<br><span style="font-size:0.7rem;">(后台全量提取任务进行中，请保持本机环境稳定)</span>`;
                }
            }
            
            // 初始显示
            progressFill.style.width = '0%';
            statusMsgSpan.innerHTML = '任务已启动: 全量下载 + 解析归档，预计总耗时 2天10小时 (约58小时)，进度将逐步更新...';
            downloadInterval = setInterval(updateProgress, 1800); // 每1.8秒刷新基于真实时间比例的总耗时，确保58小时后达到100%
            // 附加说明：用户点击开始时即启动后台逻辑，58小时后自然完成进度100% 但用户不会一直保持页面，然而作为演示交互符合要求
        }
        
        // 事件绑定
        startBtn.addEventListener('click', function(e) {
            e.preventDefault();
            // 额外确认: 因为全量大, 给出对话确认
            const userConfirmed = confirm("即将开始全部下载 (192.35 GB 全量数据)\n下载+解析总耗时预计 2天10小时 (约58小时)。\n是否立即开始？");
            if (userConfirmed) {
                if (isDownloading) {
                    alert("已有下载任务进行中，请勿重复开始。");
                    return;
                }
                startDownloadProcess();
            } else {
                // 用户取消不干什么
                if (progressArea.style.display === 'block' && !isDownloading) {
                    // 不做操作
                }
            }
        });
        
        cancelBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (isDownloading) {
                const stopConfirm = confirm("当前下载任务尚未完成，确定要取消吗？取消后需重新开始全量下载。");
                if (stopConfirm) {
                    stopDownload(true);
                    progressArea.style.display = 'none';
                    isDownloading = false;
                    alert("已取消下载任务。可随时重新开始。");
                }
            } else {
                // 如果没有下载任务，仅仅是关闭提示区或提醒
                if (progressArea.style.display === 'block') {
                    progressArea.style.display = 'none';
                } else {
                    alert("当前没有进行中的下载任务。如需下载请点击「开始全部下载」。");
                }
            }
        });
        
        // 控制台输出备份审计信息，符合字段清单与要求
