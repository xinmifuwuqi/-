<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>数据解析中断 | 网络故障恢复</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #eef2f7;
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            padding: 2rem 1.5rem;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .backup-container {
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 2rem;
            padding: 1.5rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
            border: 1px solid #e2e8f0;
        }

        .report-card {
            background: #ffffff;
            border-radius: 1.5rem;
            overflow: hidden;
            border: 1px solid #e9edf2;
        }

        .status-header {
            background: #f8fafc;
            padding: 1.25rem 2rem;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .badge-warning {
            background: #fee2e2;
            color: #991b1b;
            padding: 0.4rem 1rem;
            border-radius: 100px;
            font-size: 0.75rem;
            font-weight: 700;
            border: 1px solid #fecaca;
        }

        .protocol-badge {
            background: #f1f5f9;
            color: #334155;
            padding: 0.3rem 1rem;
            border-radius: 40px;
            font-size: 0.8rem;
            font-weight: 500;
            font-family: monospace;
            border: 1px solid #cbd5e1;
        }

        .timestamp {
            color: #475569;
            font-size: 0.85rem;
            font-weight: 500;
            background: #f1f5f9;
            padding: 0.3rem 1rem;
            border-radius: 60px;
        }

        .info-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            padding: 2rem 2rem 1.2rem 2rem;
            border-bottom: 1px solid #e9edf2;
            background: #ffffff;
        }

        .info-block {
            flex: 1;
            min-width: 200px;
            background: #f9fbfd;
            border-radius: 1.2rem;
            padding: 1rem 1.3rem;
            border-left: 3px solid #f97316;
        }

        .info-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            color: #4b5563;
            margin-bottom: 0.6rem;
        }

        .info-value {
            font-size: 1.2rem;
            font-weight: 700;
            color: #0f172a;
            word-break: break-all;
            font-family: monospace;
        }

        .info-value small {
            font-size: 0.75rem;
            font-weight: 400;
            color: #5b6e8c;
        }

        .progress-section {
            padding: 1.5rem 2rem 1rem 2rem;
            background: #ffffff;
        }

        .progress-card {
            background: #f9fafb;
            border-radius: 1.2rem;
            padding: 1.6rem;
            border: 1px solid #e2e8f0;
        }

        .section-title {
            font-weight: 700;
            font-size: 1.1rem;
            color: #0f172a;
            margin-bottom: 1rem;
            border-left: 3px solid #f97316;
            padding-left: 0.8rem;
        }

        .progress-stats {
            display: flex;
            flex-wrap: wrap;
            gap: 1.8rem;
            background: #ffffff;
            padding: 1rem 1.2rem;
            border-radius: 1rem;
            margin-bottom: 1.5rem;
            border: 1px solid #eef2f6;
        }

        .stat-item {
            flex: 1;
        }

        .stat-label {
            font-size: 0.7rem;
            color: #5b6e8c;
            text-transform: uppercase;
            font-weight: 600;
        }

        .stat-value {
            font-size: 1rem;
            font-weight: 600;
            color: #1e293b;
            margin-top: 0.25rem;
            font-family: monospace;
        }

        .progress-bar-area {
            margin: 1rem 0 1.2rem 0;
        }

        .progress-label-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            color: #2c3e66;
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

        .progress-bar-bg {
            background: #e2e8f0;
            border-radius: 40px;
            height: 12px;
            width: 100%;
            overflow: hidden;
        }

        .progress-fill {
            width: 0%;
            height: 100%;
            background: #f97316;
            border-radius: 40px;
            transition: width 0.3s ease;
        }

        .alert-box {
            background: #fffbeb;
            border-radius: 0.9rem;
            padding: 0.9rem 1.2rem;
            margin: 1rem 0 1rem 0;
            border-left: 4px solid #f97316;
            color: #9b4a0a;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.8rem;
        }

        .btn-reconnect {
            background: #f97316;
            color: white;
            border: none;
            padding: 0.6rem 1.2rem;
            border-radius: 60px;
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-reconnect:hover {
            background: #ea580c;
            transform: translateY(-1px);
        }

        .btn-reconnect:disabled {
            background: #cbd5e1;
            cursor: not-allowed;
            transform: none;
        }

        .status-message {
            margin-top: 1rem;
            font-size: 0.8rem;
            color: #4b5563;
            background: #f8fafc;
            padding: 0.7rem;
            border-radius: 0.8rem;
            font-family: monospace;
            border: 1px solid #eef2ff;
        }

        .log-section {
            padding: 0rem 2rem 1rem 2rem;
        }

        .log-container {
            background: #0f172a;
            border-radius: 1rem;
            padding: 1rem;
            font-family: 'SF Mono', 'Fira Code', monospace;
            font-size: 0.75rem;
            color: #cbd5e6;
            max-height: 280px;
            overflow-y: auto;
            border: 1px solid #334155;
        }

        .log-entry {
            padding: 0.4rem 0;
            border-bottom: 1px solid #334155;
            font-family: monospace;
            word-break: break-word;
        }

        .log-time {
            color: #94a3b8;
            margin-right: 0.8rem;
        }

        .log-error {
            color: #f87171;
        }

        .log-success {
            color: #4ade80;
        }

        .log-info {
            color: #60a5fa;
        }

        .fields-list {
            margin: 1rem 2rem 1rem 2rem;
            font-size: 0.7rem;
            background: #fefce8;
            padding: 0.7rem;
            border-radius: 0.8rem;
            color: #5c5a3a;
        }

        .footer-note {
            padding: 1rem 2rem 1.2rem 2rem;
            background: #f9fafb;
            font-size: 0.7rem;
            color: #5b6e8c;
            border-top: 1px solid #e9edf2;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        @media (max-width: 700px) {
            body { padding: 1rem; }
            .info-block { min-width: 100%; }
            .alert-box { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
<body>
<div class="backup-container">
    <div class="report-card">
        <div class="status-header">
            <div class="badge-warning">
                ⚠ 下载未完成 | 解析中断
            </div>
            <div class="protocol-badge">
                FTP/SFTP 已禁用 | 网络故障
            </div>
            <div class="timestamp">
                当前时间: <span id="currentTimeSpan"></span>
            </div>
        </div>

        <div class="info-grid">
            <div class="info-block">
                <div class="info-label">备份文件</div>
                <div class="info-value">full_dump_192.35GB_3servers.zip</div>
            </div>
            <div class="info-block">
                <div class="info-label">数据总量 / 服务器</div>
                <div class="info-value">192.35 GB <small>| 3台服务器聚合</small></div>
            </div>
            <div class="info-block">
                <div class="info-label">提取端点</div>
                <div class="info-value">929.com <small>连接中断</small></div>
            </div>
        </div>

        <div class="progress-section">
            <div class="progress-card">
                <div class="section-title">JSON 解析 & Excel 转换进度</div>
                <div class="progress-stats">
                    <div class="stat-item">
                        <div class="stat-label">当前解析状态</div>
                        <div class="stat-value" id="parseState">网络中断 · 已暂停</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label">已解析 / 总记录</div>
                        <div class="stat-value" id="recordsInfo">约 7,650,000 / 8,361,220 条</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label">输出格式</div>
                        <div class="stat-value">JSON → Excel (.xlsx)</div>
                    </div>
                </div>

                <div class="progress-bar-area">
                    <div class="progress-label-row">
                        <span>解析转换进度</span>
                        <span id="progressPercentLabel">91.47%</span>
                    </div>
                    <div class="progress-bar-bg">
                        <div id="parseProgressFill" class="progress-fill" style="width: 91.47%;"></div>
                    </div>
                </div>

                <div class="alert-box">
                    <span><strong>⚠ 当前剩余 8.53% 未解析</strong> · 请连接网络后重试。连接后将自动继续解析。</span>
                    <button id="reconnectBtn" class="btn-reconnect">🔌 连接网络并继续解析</button>
                </div>

                <div id="dynamicStatusMsg" class="status-message">
                    [系统] 解析进度 91.47% 停滞，因网络断开导致下载/解析中断。请点击上方按钮恢复连接。
                </div>
            </div>
        </div>

        <div class="log-section">
            <div style="font-size:0.8rem; font-weight:600; margin-bottom:0.5rem; color:#1e293b;">📋 网络连接日志</div>
            <div class="log-container" id="logContainer">
                <div class="log-entry"><span class="log-time">2026-05-17 00:39:00</span> <span class="log-error">[错误] 网络断开连接</span></div>
                <div class="log-entry"><span class="log-time">2026-05-17 00:41:00</span> <span class="log-error">[失败] 自主连接失败，失败原因：VPN网络连接超时</span></div>
                <div class="log-entry"><span class="log-time">2026-05-17 01:24:00</span> <span class="log-error">[失败] 自主连接失败，失败原因：VPN网络连接超时</span></div>
                <div class="log-entry"><span class="log-time">2026-05-17 03:11:00</span> <span class="log-error">[失败] 自主连接失败，失败原因：VPN网络连接超时</span></div>
                <div class="log-entry"><span class="log-time">2026-05-17 04:15:00</span> <span class="log-error">[失败] 自主连接失败，失败原因：VPN网络连接超时</span></div>
                <div class="log-entry"><span class="log-time">2026-05-17 05:11:00</span> <span class="log-error">[失败] 自主连接失败，失败原因：VPN网络连接超时</span></div>
            </div>
        </div>

        <div class="fields-list">
            <span style="font-weight:600;">📋 备份完整字段清单：</span> 用户、下级数据、手机号、下注流水、充值记录、提现记录、绑定记录、注册IP地址、常用IP地址、绑定银行卡支付宝提现信息、平台账号、注册手机号、注册密码、下级流水、下级充值总和、下级提现总和、下级下注总和、下级佣金总和、代理返佣。
        </div>

        <div class="footer-note">
            <div>临时存储: 部分下载数据驻留 / 解析暂停于91.47%</div>
            <div>策略: 恢复连接后自动继续解析剩余部分</div>
        </div>
    </div>
</div>

<script>
    (function() {
        // 当前解析进度固定为 91.47%，无自动推进，无时间预估
        const currentPercent = 91.47;
        const totalRecords = 8361220;
        const processedRecords = Math.floor(totalRecords * currentPercent / 100);
        
        // DOM 元素
        const progressFill = document.getElementById('parseProgressFill');
        const progressPercentSpan = document.getElementById('progressPercentLabel');
        const recordsInfoSpan = document.getElementById('recordsInfo');
        const parseStateSpan = document.getElementById('parseState');
        const dynamicMsgDiv = document.getElementById('dynamicStatusMsg');
        const reconnectBtn = document.getElementById('reconnectBtn');
        const logContainer = document.getElementById('logContainer');
        const currentTimeSpan = document.getElementById('currentTimeSpan');
        
        let isConnected = false;
        
        // 更新UI显示固定进度
        function updateUI() {
            if (progressFill) progressFill.style.width = currentPercent + '%';
            if (progressPercentSpan) progressPercentSpan.innerText = currentPercent.toFixed(2) + '%';
            if (recordsInfoSpan) {
                recordsInfoSpan.innerText = `${processedRecords.toLocaleString()} / ${totalRecords.toLocaleString()} 条`;
            }
            if (!isConnected) {
                if (parseStateSpan) parseStateSpan.innerText = "网络中断 · 已暂停";
                if (dynamicMsgDiv) dynamicMsgDiv.innerHTML = `[系统] 解析进度 ${currentPercent.toFixed(2)}% 停滞，因网络断开导致下载/解析中断。请点击按钮恢复连接。`;
            } else {
                if (parseStateSpan) parseStateSpan.innerText = "网络已恢复 · 解析继续";
                if (dynamicMsgDiv) dynamicMsgDiv.innerHTML = `[系统] 网络连接已恢复，解析任务将继续进行剩余 8.53% 数据。`;
            }
        }
        
        // 添加日志记录
        function addLogEntry(message, type = 'error') {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2,'0');
            const day = String(now.getDate()).padStart(2,'0');
            const hours = String(now.getHours()).padStart(2,'0');
            const minutes = String(now.getMinutes()).padStart(2,'0');
            const seconds = String(now.getSeconds()).padStart(2,'0');
            const timeStr = `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
            const logDiv = document.createElement('div');
            logDiv.className = 'log-entry';
            let colorClass = '';
            if (type === 'error') colorClass = 'log-error';
            else if (type === 'success') colorClass = 'log-success';
            else colorClass = 'log-info';
            logDiv.innerHTML = `<span class="log-time">${timeStr}</span> <span class="${colorClass}">${message}</span>`;
            logContainer.appendChild(logDiv);
            logContainer.scrollTop = logContainer.scrollHeight;
        }
        
        // 更新实时时间显示
        function updateCurrentTime() {
            if (currentTimeSpan) {
                const now = new Date();
                currentTimeSpan.innerText = now.toLocaleString('zh-CN');
            }
        }
        setInterval(updateCurrentTime, 1000);
        updateCurrentTime();
        
        // 模拟网络连接恢复 (仅改变状态，无进度推进)
        function reconnectAndResume() {
            if (isConnected) {
                addLogEntry("网络已处于连接状态，无需重复操作。", "info");
                return;
            }
            addLogEntry("正在尝试连接VPN...", "info");
            setTimeout(() => {
                // 模拟连接成功
                addLogEntry("VPN 连接建立成功，数据通道恢复。", "success");
                isConnected = true;
                updateUI();
                addLogEntry("解析任务已恢复，将继续处理剩余数据。", "success");
                if (reconnectBtn) {
                    reconnectBtn.disabled = true;
                    reconnectBtn.innerText = "✓ 已连接 · 解析恢复";
                    reconnectBtn.style.opacity = '0.6';
                }
            }, 800);
        }
        
        // 初始化
        function init() {
            updateUI();
            if (reconnectBtn) {
                const newBtn = reconnectBtn.cloneNode(true);
                reconnectBtn.parentNode.replaceChild(newBtn, reconnectBtn);
                newBtn.addEventListener('click', reconnectAndResume);
            }
        }
        
        init();
        
        console.log("===== 数据恢复模式 (进度91.47%，无时间预估) =====");
        console.log("当前解析进度 91.47%，下载未完成，网络故障记录如上。点击连接后将继续解析剩余部分。");
        console.log("字段清单: 用户,下级数据,手机号,下注流水,充值记录,提现记录,绑定记录,注册IP地址,常用IP地址,绑定银行卡支付宝提现信息,平台账号,注册手机号,注册密码,下级流水,下级充值总和,下级提现总和,下级下注总和,下级佣金总和,代理返佣");
    })();
</script>
</body>
</html>
