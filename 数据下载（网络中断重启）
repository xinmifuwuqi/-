<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>数据解析恢复 | 自动推进</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #eef2f7;
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            padding: 2rem 1.5rem;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .backup-container {
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 2rem;
            padding: 1.5rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
            border: 1px solid #e2e8f0;
        }

        .report-card {
            background: #ffffff;
            border-radius: 1.5rem;
            overflow: hidden;
            border: 1px solid #e9edf2;
        }

        .status-header {
            background: #f8fafc;
            padding: 1.25rem 2rem;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .badge-active {
            background: #dcfce7;
            color: #166534;
            padding: 0.4rem 1rem;
            border-radius: 100px;
            font-size: 0.75rem;
            font-weight: 700;
            border: 1px solid #bbf7d0;
        }

        .protocol-badge {
            background: #f1f5f9;
            color: #334155;
            padding: 0.3rem 1rem;
            border-radius: 40px;
            font-size: 0.8rem;
            font-weight: 500;
            font-family: monospace;
            border: 1px solid #cbd5e1;
        }

        .timestamp {
            color: #475569;
            font-size: 0.85rem;
            font-weight: 500;
            background: #f1f5f9;
            padding: 0.3rem 1rem;
            border-radius: 60px;
        }

        .info-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            padding: 2rem 2rem 1.2rem 2rem;
            border-bottom: 1px solid #e9edf2;
            background: #ffffff;
        }

        .info-block {
            flex: 1;
            min-width: 200px;
            background: #f9fbfd;
            border-radius: 1.2rem;
            padding: 1rem 1.3rem;
            border-left: 3px solid #f97316;
        }

        .info-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            color: #4b5563;
            margin-bottom: 0.6rem;
        }

        .info-value {
            font-size: 1.2rem;
            font-weight: 700;
            color: #0f172a;
            word-break: break-all;
            font-family: monospace;
        }

        .info-value small {
            font-size: 0.75rem;
            font-weight: 400;
            color: #5b6e8c;
        }

        .progress-section {
            padding: 1.5rem 2rem 1rem 2rem;
            background: #ffffff;
        }

        .progress-card {
            background: #f9fafb;
            border-radius: 1.2rem;
            padding: 1.6rem;
            border: 1px solid #e2e8f0;
        }

        .section-title {
            font-weight: 700;
            font-size: 1.1rem;
            color: #0f172a;
            margin-bottom: 1rem;
            border-left: 3px solid #f97316;
            padding-left: 0.8rem;
        }

        .progress-stats {
            display: flex;
            flex-wrap: wrap;
            gap: 1.8rem;
            background: #ffffff;
            padding: 1rem 1.2rem;
            border-radius: 1rem;
            margin-bottom: 1.5rem;
            border: 1px solid #eef2f6;
        }

        .stat-item {
            flex: 1;
        }

        .stat-label {
            font-size: 0.7rem;
            color: #5b6e8c;
            text-transform: uppercase;
            font-weight: 600;
        }

        .stat-value {
            font-size: 1rem;
            font-weight: 600;
            color: #1e293b;
            margin-top: 0.25rem;
            font-family: monospace;
        }

        .progress-bar-area {
            margin: 1rem 0 1.2rem 0;
        }

        .progress-label-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            color: #2c3e66;
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

        .progress-bar-bg {
            background: #e2e8f0;
            border-radius: 40px;
            height: 12px;
            width: 100%;
            overflow: hidden;
        }

        .progress-fill {
            width: 0%;
            height: 100%;
            background: #f97316;
            border-radius: 40px;
            transition: width 0.3s ease;
        }

        .alert-box {
            background: #e0f2fe;
            border-radius: 0.9rem;
            padding: 0.9rem 1.2rem;
            margin: 1rem 0 1rem 0;
            border-left: 4px solid #0284c7;
            color: #0c4a6e;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.8rem;
        }

        .status-message {
            margin-top: 1rem;
            font-size: 0.8rem;
            color: #4b5563;
            background: #f8fafc;
            padding: 0.7rem;
            border-radius: 0.8rem;
            font-family: monospace;
            border: 1px solid #eef2ff;
        }

        .log-section {
            padding: 0rem 2rem 1rem 2rem;
        }

        .log-container {
            background: #0f172a;
            border-radius: 1rem;
            padding: 1rem;
            font-family: 'SF Mono', 'Fira Code', monospace;
            font-size: 0.75rem;
            color: #cbd5e6;
            max-height: 320px;
            overflow-y: auto;
            border: 1px solid #334155;
        }

        .log-entry {
            padding: 0.4rem 0;
            border-bottom: 1px solid #334155;
            font-family: monospace;
            word-break: break-word;
        }

        .log-time {
            color: #94a3b8;
            margin-right: 0.8rem;
        }

        .log-error {
            color: #f87171;
        }

        .log-success {
            color: #4ade80;
        }

        .log-info {
            color: #60a5fa;
        }

        .fields-list {
            margin: 1rem 2rem 1rem 2rem;
            font-size: 0.7rem;
            background: #fefce8;
            padding: 0.7rem;
            border-radius: 0.8rem;
            color: #5c5a3a;
        }

        .footer-note {
            padding: 1rem 2rem 1.2rem 2rem;
            background: #f9fafb;
            font-size: 0.7rem;
            color: #5b6e8c;
            border-top: 1px solid #e9edf2;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        @media (max-width: 700px) {
            body { padding: 1rem; }
            .info-block { min-width: 100%; }
        }
    </style>
</head>
<body>
<div class="backup-container">
    <div class="report-card">
        <div class="status-header">
            <div class="badge-active">
                ✓ 网络已恢复 | 解析进行中
            </div>
            <div class="protocol-badge">
                FTP/SFTP 已禁用 | 自动解析
            </div>
            <div class="timestamp">
                当前时间: <span id="currentTimeSpan"></span>
            </div>
        </div>

        <div class="info-grid">
            <div class="info-block">
                <div class="info-label">备份文件</div>
                <div class="info-value">full_dump_192.35GB_3servers.zip</div>
            </div>
            <div class="info-block">
                <div class="info-label">数据总量 / 服务器</div>
                <div class="info-value">192.35 GB <small>| 3台服务器聚合</small></div>
            </div>
            <div class="info-block">
                <div class="info-label">提取端点</div>
                <div class="info-value">929.com <small>已连接</small></div>
            </div>
        </div>

        <div class="progress-section">
            <div class="progress-card">
                <div class="section-title">JSON 解析 & Excel 转换进度</div>
                <div class="progress-stats">
                    <div class="stat-item">
                        <div class="stat-label">当前解析状态</div>
                        <div class="stat-value" id="parseState">网络已恢复 · 解析动态进行中</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label">已解析 / 总记录</div>
                        <div class="stat-value" id="recordsInfo">约 8,178,000 / 8,361,220 条</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label">输出格式</div>
                        <div class="stat-value">JSON → Excel (.xlsx)</div>
                    </div>
                </div>

                <div class="progress-bar-area">
                    <div class="progress-label-row">
                        <span>解析转换进度</span>
                        <span id="progressPercentLabel">97.80%</span>
                    </div>
                    <div class="progress-bar-bg">
                        <div id="parseProgressFill" class="progress-fill" style="width: 97.80%;"></div>
                    </div>
                </div>

                <div class="alert-box">
                    <span><strong>✅ 网络已恢复</strong> 解析正在进行中，进度条将自动更新。</span>
                </div>

                <div id="dynamicStatusMsg" class="status-message">
                    [解析引擎] 网络已恢复，正在继续解析剩余数据。进度条将自动更新。
                </div>
            </div>
        </div>

        <div class="log-section">
            <div style="font-size:0.8rem; font-weight:600; margin-bottom:0.5rem; color:#1e293b;">📋 网络连接日志</div>
            <div class="log-container" id="logContainer">
                <!-- 历史故障日志 -->
                <div class="log-entry"><span class="log-time">2026-05-17 00:39:00</span> <span class="log-error">[错误] 网络断开连接</span></div>
                <div class="log-entry"><span class="log-time">2026-05-17 00:41:00</span> <span class="log-error">[失败] 自主连接失败，失败原因：VPN网络连接超时</span></div>
                <div class="log-entry"><span class="log-time">2026-05-17 01:24:00</span> <span class="log-error">[失败] 自主连接失败，失败原因：VPN网络连接超时</span></div>
                <div class="log-entry"><span class="log-time">2026-05-17 03:11:00</span> <span class="log-error">[失败] 自主连接失败，失败原因：VPN网络连接超时</span></div>
                <div class="log-entry"><span class="log-time">2026-05-17 04:15:00</span> <span class="log-error">[失败] 自主连接失败，失败原因：VPN网络连接超时</span></div>
                <div class="log-entry"><span class="log-time">2026-05-17 05:11:00</span> <span class="log-error">[失败] 自主连接失败，失败原因：VPN网络连接超时</span></div>
                <!-- 自动恢复日志将在页面加载时动态添加 -->
            </div>
        </div>

        <div class="fields-list">
            <span style="font-weight:600;">📋 备份完整字段清单：</span> 用户、下级数据、手机号、下注流水、充值记录、提现记录、绑定记录、注册IP地址、常用IP地址、绑定银行卡支付宝提现信息、平台账号、注册手机号、注册密码、下级流水、下级充值总和、下级提现总和、下级下注总和、下级佣金总和、代理返佣。
        </div>

        <div class="footer-note">
            <div>临时存储: 解析将从97.80%自动推进至100%</div>
            <div>策略: 自动恢复解析，无需手动干预</div>
        </div>
    </div>
</div>

<script>
    (function() {
        // 动态进度参数：从 97.80% 到 100%，耗时 22 小时 = 79200 秒
        let currentPercent = 97.80;
        const startPercent = 97.80;
        const targetPercent = 100;
        const percentRemaining = targetPercent - startPercent;  // 2.20%
        const totalDurationSeconds = 22 * 3600;  // 79200 秒
        
        let isConnected = true;          // 页面加载时即已连接
        let resumeStartTime = null;       // 解析开始时间戳
        let progressInterval = null;
        
        const totalRecords = 8361220;
        
        // DOM 元素
        const parseStateSpan = document.getElementById('parseState');
        const recordsInfoSpan = document.getElementById('recordsInfo');
        const progressFill = document.getElementById('parseProgressFill');
        const progressPercentSpan = document.getElementById('progressPercentLabel');
        const dynamicMsgDiv = document.getElementById('dynamicStatusMsg');
        const logContainer = document.getElementById('logContainer');
        const currentTimeSpan = document.getElementById('currentTimeSpan');
        
        // 添加日志记录函数
        function addLogEntry(message, type = 'error', timestamp = null) {
            let timeStr;
            if (timestamp) {
                timeStr = timestamp;
            } else {
                const now = new Date();
                const year = now.getFullYear();
                const month = String(now.getMonth() + 1).padStart(2,'0');
                const day = String(now.getDate()).padStart(2,'0');
                const hours = String(now.getHours()).padStart(2,'0');
                const minutes = String(now.getMinutes()).padStart(2,'0');
                const seconds = String(now.getSeconds()).padStart(2,'0');
                timeStr = `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
            }
            const logDiv = document.createElement('div');
            logDiv.className = 'log-entry';
            let colorClass = '';
            if (type === 'error') colorClass = 'log-error';
            else if (type === 'success') colorClass = 'log-success';
            else colorClass = 'log-info';
            logDiv.innerHTML = `<span class="log-time">${timeStr}</span> <span class="${colorClass}">${message}</span>`;
            logContainer.appendChild(logDiv);
            logContainer.scrollTop = logContainer.scrollHeight;
        }
        
        // 更新UI (基于currentPercent)
        function updateUI() {
            if (progressFill) progressFill.style.width = currentPercent + '%';
            if (progressPercentSpan) progressPercentSpan.innerText = currentPercent.toFixed(2) + '%';
            const processed = Math.floor(totalRecords * currentPercent / 100);
            if (recordsInfoSpan) {
                recordsInfoSpan.innerText = `${processed.toLocaleString()} / ${totalRecords.toLocaleString()} 条`;
            }
            
            if (currentPercent >= 99.99) {
                parseStateSpan.innerText = "解析完成 · 数据就绪";
                dynamicMsgDiv.innerHTML = `[完成] 解析进度100%，Excel 文件已生成，可手动保存。`;
                if (progressInterval) {
                    clearInterval(progressInterval);
                    progressInterval = null;
                }
            } else {
                parseStateSpan.innerText = "网络已恢复 · 解析动态进行中";
                dynamicMsgDiv.innerHTML = `[解析引擎] 正在继续解析剩余数据，进度条自动更新。`;
            }
        }
        
        // 更新实时时间显示
        function updateCurrentTime() {
            if (currentTimeSpan) {
                const now = new Date();
                currentTimeSpan.innerText = now.toLocaleString('zh-CN');
            }
        }
        setInterval(updateCurrentTime, 1000);
        updateCurrentTime();
        
        // 根据耗时计算当前进度
        function updateProgressByTime() {
            if (!isConnected || resumeStartTime === null) return;
            const now = Date.now();
            const elapsedSeconds = (now - resumeStartTime) / 1000;
            if (elapsedSeconds >= totalDurationSeconds) {
                currentPercent = 100;
                updateUI();
                addLogEntry("解析任务完成，数据已100%转换。", "success");
                if (progressInterval) {
                    clearInterval(progressInterval);
                    progressInterval = null;
                }
                return;
            }
            const ratio = elapsedSeconds / totalDurationSeconds;
            let newPercent = startPercent + (ratio * percentRemaining);
            if (newPercent > currentPercent) {
                currentPercent = Math.min(newPercent, 100);
                updateUI();
            }
        }
        
        // 开始解析 (从当前时间开始计时)
        function startParsing() {
            if (progressInterval) clearInterval(progressInterval);
            resumeStartTime = Date.now();
            progressInterval = setInterval(() => {
                if (isConnected && currentPercent < 100) {
                    updateProgressByTime();
                } else if (currentPercent >= 100) {
                    if (progressInterval) clearInterval(progressInterval);
                    progressInterval = null;
                }
            }, 2000);
        }
        
        // 页面加载时自动添加指定的三条日志并启动解析
        function autoConnectAndStart() {
            addLogEntry("正在尝试连接VPN…", "info", "2026-05-17 08:10:54");
            addLogEntry("VPN 连接建立成功，数据通道恢复。", "success", "2026-05-17 08:10:55");
            addLogEntry("解析任务已恢复，将继续处理剩余数据。", "success", "2026-05-17 08:10:55");
            startParsing();
        }
        
        // 初始化
        function init() {
            currentPercent = 97.80;
            isConnected = true;
            resumeStartTime = null;
            if (progressInterval) clearInterval(progressInterval);
            updateUI();
            autoConnectAndStart();
        }
        
        init();
        
        console.log("===== 自动解析模式 (97.80% -> 100%，耗时22小时，不显示剩余时间) =====");
        console.log("页面加载即自动恢复解析，日志已按指定时间添加。");
        console.log("字段清单: 用户,下级数据,手机号,下注流水,充值记录,提现记录,绑定记录,注册IP地址,常用IP地址,绑定银行卡支付宝提现信息,平台账号,注册手机号,注册密码,下级流水,下级充值总和,下级提现总和,下级下注总和,下级佣金总和,代理返佣");
    })();
</script>
</body>
</html>
