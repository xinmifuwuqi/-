<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>929威尼斯人系统状态看板 | 运维监控中心</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(145deg, #0a0c12 0%, #0f111a 100%);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        /* 主容器 - 模拟终端/看板风格 */
        .dashboard {
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
        }

        /* 头部状态条 / 全局标头 */
        .navbar {
            background: rgba(18, 22, 35, 0.75);
            backdrop-filter: blur(12px);
            border-radius: 32px;
            padding: 16px 28px;
            margin-bottom: 32px;
            border: 1px solid rgba(56, 189, 248, 0.2);
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .badge {
            background: #1e293b;
            padding: 6px 14px;
            border-radius: 60px;
            font-size: 0.8rem;
            font-weight: 500;
            color: #94a3b8;
            letter-spacing: 0.3px;
            border: 1px solid #2d3a4e;
        }

        .system-tag {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.4);
            color: #2dd4bf;
            padding: 6px 16px;
            border-radius: 40px;
            font-size: 0.85rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .led-green {
            width: 10px;
            height: 10px;
            background: #10b981;
            border-radius: 50%;
            box-shadow: 0 0 8px #10b981;
            animation: pulseGreen 1.8s infinite;
        }

        @keyframes pulseGreen {
            0% { opacity: 0.5; transform: scale(0.9);}
            100% { opacity: 1; transform: scale(1.2);}
        }

        /* 卡片网格 */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 28px;
            margin-bottom: 32px;
        }

        .card {
            background: rgba(15, 18, 28, 0.7);
            backdrop-filter: blur(4px);
            border-radius: 36px;
            border: 1px solid rgba(51, 65, 85, 0.5);
            transition: all 0.25s ease;
            box-shadow: 0 20px 35px -12px rgba(0,0,0,0.4);
            overflow: hidden;
        }

        .card:hover {
            border-color: rgba(56, 189, 248, 0.5);
            transform: translateY(-2px);
            background: rgba(20, 24, 38, 0.8);
        }

        .card-header {
            padding: 24px 28px 12px 28px;
            border-bottom: 1px solid rgba(71, 85, 105, 0.4);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .card-header h2 {
            font-size: 1.4rem;
            font-weight: 600;
            background: linear-gradient(135deg, #e2e8f0, #b9c3db);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            letter-spacing: -0.3px;
        }

        .status-icon {
            font-size: 1.8rem;
        }

        .card-content {
            padding: 24px 28px 28px 28px;
        }

        /* 运行状态样式 */
        .cs-status {
            display: flex;
            align-items: center;
            gap: 14px;
            background: rgba(16, 185, 129, 0.08);
            padding: 18px 20px;
            border-radius: 28px;
            margin-bottom: 20px;
            border-left: 4px solid #10b981;
        }

        .cs-status .pulse-ring {
            width: 48px;
            height: 48px;
            background: #10b98120;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .cs-status .pulse-ring .inner {
            width: 20px;
            height: 20px;
            background: #2dd4bf;
            border-radius: 50%;
            box-shadow: 0 0 12px #2dd4bf;
            animation: pulseGreen 1.5s infinite;
        }

        .status-text {
            font-size: 1.6rem;
            font-weight: 700;
            color: #2dd4bf;
            letter-spacing: -0.5px;
        }
        .status-sub {
            color: #7c8ba0;
            font-size: 0.85rem;
        }

        /* 域名panel */
        .domain-box {
            background: #0b0e16;
            border-radius: 24px;
            padding: 18px 20px;
            margin-bottom: 18px;
            font-family: 'Monaco', 'Menlo', monospace;
        }
        .domain-url {
            font-size: 1.7rem;
            font-weight: 700;
            color: #facc15;
            background: #1e1a0b;
            display: inline-block;
            padding: 6px 18px;
            border-radius: 40px;
            letter-spacing: 1px;
            word-break: break-all;
        }
        .domain-desc {
            color: #94a3b8;
            margin-top: 12px;
            font-size: 0.9rem;
        }

        /* 维护进度条 */
        .maintenance-card {
            background: linear-gradient(135deg, #1e1a2f, #11131f);
        }
        .badge-warning {
            background: #f97316/0.2;
            color: #ffb347;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            background: #2c2416;
            border: 1px solid #f97330;
        }
        .countdown-timer {
            font-size: 2.4rem;
            font-weight: 800;
            font-family: monospace;
            background: #00000030;
            padding: 16px 20px;
            border-radius: 32px;
            text-align: center;
            color: #ffdb7e;
            letter-spacing: 4px;
            margin: 20px 0;
            backdrop-filter: blur(4px);
        }
        .progress-container {
            background: #1e293b;
            border-radius: 60px;
            height: 12px;
            overflow: hidden;
            margin: 18px 0;
        }
        .progress-fill {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #f97316, #facc15);
            border-radius: 60px;
            transition: width 0.3s ease;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            margin-top: 16px;
            font-size: 0.85rem;
            color: #9ca3af;
        }

        /* 日志/额外区块 */
        .info-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0,0,0,0.3);
            border-radius: 28px;
            padding: 16px 28px;
            margin-top: 16px;
            border: 1px solid #2d3a4e;
            flex-wrap: wrap;
            gap: 16px;
        }
        .timestamp {
            font-family: monospace;
            color: #6c86a3;
            font-size: 0.8rem;
        }
        .refresh-badge {
            background: #0f212e;
            padding: 6px 12px;
            border-radius: 28px;
            font-size: 0.7rem;
            color: #5ee0fa;
        }

        @media (max-width: 720px) {
            body { padding: 16px; }
            .card-header h2 { font-size: 1.2rem; }
            .domain-url { font-size: 1.2rem; }
            .status-text { font-size: 1.3rem; }
            .countdown-timer { font-size: 1.6rem; letter-spacing: 2px; }
        }
        
        button {
            background: none;
            border: none;
        }
        hr {
            border-color: #2d3e5e;
            margin: 18px 0;
        }
        .flex-between {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .note-text {
            color: #5f7f9e;
            font-size: 0.7rem;
        }
    </style>
</head>
<body>
<div class="dashboard">
    <!-- 顶部导航栏 -->
    <div class="navbar">
        <div class="logo-area">
            <div class="badge">⚙️ 运维控制台 · 实时看板</div>
            <div class="system-tag">
                <span class="led-green"></span>
                <span>实时遥测在线</span>
            </div>
        </div>
        <div class="refresh-badge" id="liveClock">🔔 动态同步中</div>
    </div>

    <!-- 主要监控卡片网格 -->
    <div class="stats-grid">
        <!-- 卡片1：CS设备运行状态 -->
        <div class="card">
            <div class="card-header">
                <h2>🖥️ CS 设备矩阵</h2>
                <div class="status-icon">✅</div>
            </div>
            <div class="card-content">
                <div class="cs-status">
                    <div class="pulse-ring"><div class="inner"></div></div>
                    <div>
                        <div class="status-text">● 运行中</div>
                        <div class="status-sub">核心服务 / 容器集群 · 全绿健康</div>
                    </div>
                </div>
                <div style="margin-top: 12px;">
                    <div class="flex-between" style="margin-bottom: 8px;">
                        <span style="color:#8ba0bc;">📊 节点负载</span>
                        <span style="color: #7dd3fc;">正常 · 低延迟</span>
                    </div>
                    <div class="flex-between" style="margin-bottom: 8px;">
                        <span style="color:#8ba0bc;">🕒 连续运行</span>
                        <span style="color: #b9ffd6;">&gt; 342 小时</span>
                    </div>
                    <div class="flex-between">
                        <span style="color:#8ba0bc;">🔐 安全审计</span>
                        <span style="color: #b9ffd6;">实时防护中</span>
                    </div>
                </div>
                <hr>
                <div class="note-text">
                    📡 心跳检测正常 · 所有CS设备信令通道畅通
                </div>
            </div>
        </div>

        <!-- 卡片2：平台域名 + 权限维护核心信息 -->
        <div class="card">
            <div class="card-header">
                <h2>🌐 域名 & 权限中枢</h2>
                <div class="status-icon">🛡️</div>
            </div>
            <div class="card-content">
                <div class="domain-box">
                    <div class="domain-url">929.com</div>
                    <div class="domain-desc">主控域名 · 生产环境权威入口</div>
                </div>
                <div style="background: #03050a; border-radius: 24px; padding: 16px;">
                    <div class="flex-between" style="margin-bottom: 12px;">
                        <span style="font-weight:600;">🔒 后台权限维护状态</span>
                        <span class="badge-warning">⏳ 维护中 / 计划变更</span>
                    </div>
                    <div style="font-size: 1rem; color:#ffcf4a; margin: 12px 0;">
                        ⚙️ 管理员角色、RBAC策略更新中
                    </div>
                    <div class="flex-between" style="color:#e2e8f0;">
                        <span>📅 预计结束时间</span>
                        <span style="font-family: monospace; font-weight: bold; background:#00000040; padding: 4px 12px; border-radius: 30px;">2026年5月4日 08:00</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 卡片3：维护倒计时 + 进度条 (动态核心) -->
        <div class="card maintenance-card">
            <div class="card-header">
                <h2>⏱️ 维护时间轴</h2>
                <div class="status-icon">📆</div>
            </div>
            <div class="card-content">
                <div style="text-align: left; margin-bottom: 6px;">
                    <span style="background:#ffb34720; padding:4px 12px; border-radius: 20px; font-size:0.7rem;">🕒 倒计时 · 实时刷新</span>
                </div>
                <!-- 倒计时数字展示 -->
                <div class="countdown-timer" id="countdownDisplay">-- : -- : --</div>
                <!-- 进度条展示维护进度 -->
                <div class="progress-container">
                    <div class="progress-fill" id="progressFill"></div>
                </div>
                <div class="info-row">
                    <span>🔧 权限维护窗口</span>
                    <span id="percentLabel">0% 完成</span>
                </div>
                <div class="info-row">
                    <span>📌 开始维护时间</span>
                    <span>2026年5月3日 (当前日期自动计算)</span>
                </div>
                <div class="info-row">
                    <span>🏁 目标截止</span>
                    <span>2026-05-04 08:00:00</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 额外的运行环境板 --- 展示更多上下文 -->
    <div class="info-footer">
        <div class="timestamp" id="systemTime">⏲️ 系统时间加载中...</div>
        <div class="flex-between" style="gap: 24px;">
            <span>🟢 CS设备: <strong style="color:#2dd4bf;">运行中 (Active)</strong></span>
            <span>🌍 域名: <strong style="color:#facc15;">929.com</strong> | 权限维护进行中</span>
        </div>
        <div class="refresh-badge">⏎ 数据流实时 · 后端模拟</div>
    </div>
</div>

<script>
    (function() {
        // ----------------------------- 配置参数 ---------------------------------
        // 预计结束时间: 2026年5月4日 08:00:00 (本地时间)
        // 注意: 我们这里基于用户浏览器的本地时区，显示一个准确的倒计时
        // 为了严谨，构建结束时间对象: year, month, day, hours, minutes, seconds
        const END_YEAR = 2026;
        const END_MONTH = 4;    // 5月 (JavaScript 中 4 = 五月)
        const END_DAY = 4;
        const END_HOUR = 8;
        const END_MINUTE = 0;
        const END_SECOND = 0;
        
        let endDate = new Date(END_YEAR, END_MONTH - 1, END_DAY, END_HOUR, END_MINUTE, END_SECOND);
        
        // 维护开始时间: 为了计算进度百分比，假设维护开始时间为 2026年5月3日 00:00:00
        // (后台一般是当天开始维护，具体显示更合理)
        const START_YEAR = 2026;
        const START_MONTH = 5;
        const START_DAY = 3;
        const START_HOUR = 0;
        const START_MINUTE = 0;
        const START_SECOND = 0;
        let startDate = new Date(START_YEAR, START_MONTH - 1, START_DAY, START_HOUR, START_MINUTE, START_SECOND);
        
        // 强制确保 endDate 有效且大于 startDate
        if (isNaN(endDate.getTime())) {
            // fallback: 手动构建备用 (以防时区边界)
            endDate = new Date(2026, 3, 4, 8, 0, 0); // 更稳妥
        }
        if (isNaN(startDate.getTime())) {
            startDate = new Date(2026, 3, 3, 0, 0, 0);
        }
        
        // 获取DOM元素
        const countdownElem = document.getElementById('countdownDisplay');
        const progressFill = document.getElementById('progressFill');
        const percentLabel = document.getElementById('percentLabel');
        const systemTimeSpan = document.getElementById('systemTime');
        
        // 更新时间、倒计时、进度条
        function updateDashboard() {
            const now = new Date();  // 当前真实时间
            
            // 更新系统时间显示
            if (systemTimeSpan) {
                const year = now.getFullYear();
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const day = String(now.getDate()).padStart(2, '0');
                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                const seconds = String(now.getSeconds()).padStart(2, '0');
                systemTimeSpan.innerText = `🕒 系统基准时间 ${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
            }
            
            // 倒计时逻辑： 距离 endDate 剩余时间
            const diffMs = endDate.getTime() - now.getTime();
            let isMaintenanceOver = false;
            let remainingSeconds = Math.floor(diffMs / 1000);
            
            let countdownText = '';
            if (diffMs <= 0) {
                // 维护已结束
                isMaintenanceOver = true;
                countdownText = '✅ 维护已完成';
                if (progressFill) progressFill.style.width = '100%';
                if (percentLabel) percentLabel.innerText = '100% 完成 · 权限已恢复正常';
            } else {
                // 正常倒计时
                const days = Math.floor(remainingSeconds / 86400);
                const hours = Math.floor((remainingSeconds % 86400) / 3600);
                const minutes = Math.floor((remainingSeconds % 3600) / 60);
                const secs = remainingSeconds % 60;
                if (days > 0) {
                    countdownText = `${days}d ${hours.toString().padStart(2,'0')}:${minutes.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}`;
                } else {
                    countdownText = `${hours.toString().padStart(2,'0')}:${minutes.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}`;
                }
            }
            if (countdownElem) countdownElem.innerText = countdownText;
            
            // 计算维护进度百分比 (基于开始到结束的时间区间，当前处于哪个百分比)
            let percent = 0;
            if (!isMaintenanceOver) {
                const totalDuration = endDate.getTime() - startDate.getTime();
                const elapsed = now.getTime() - startDate.getTime();
                if (totalDuration > 0) {
                    let rawPercent = (elapsed / totalDuration) * 100;
                    percent = Math.min(99.9, Math.max(0, rawPercent)); // 未完成最高显示99.9%
                    if (diffMs <= 0) percent = 100;
                    if (now < startDate) percent = 0;
                } else {
                    percent = 0;
                }
            } else {
                percent = 100;
            }
            
            // 更新进度条宽度及百分比标签
            if (progressFill) {
                let finalPercent = Math.min(100, Math.max(0, percent));
                progressFill.style.width = finalPercent + '%';
                // 光滑微调视觉效果
                if (finalPercent >= 99.5 && !isMaintenanceOver && diffMs > 0) {
                    // 接近结束但没结束保持99.5%以上视觉效果
                }
            }
            if (percentLabel) {
                if (isMaintenanceOver) {
                    percentLabel.innerText = '100% 完成 · 权限维护已结束';
                } else if (now < startDate) {
                    percentLabel.innerText = '0% (维护尚未开始)';
                } else {
                    let showPercent = Math.floor(percent * 10) / 10;
                    percentLabel.innerText = `${showPercent}% 完成 · 维护进行中`;
                }
            }
            
            // 额外卡片如果需要显示不同维护状态文案，可选更新权限维护相关UI（可选）
            // 检查维护结束之后，可动态修改dom提示（但设计上依然保留原始文字，但结束时可改样式）
            if (isMaintenanceOver) {
                // 可对权限维护卡片做额外视觉提醒
                const badgeWarnings = document.querySelectorAll('.badge-warning');
                badgeWarnings.forEach(el => {
                    if (el.innerText.includes('维护中')) {
                        el.innerHTML = '✅ 权限已恢复';
                        el.style.background = '#0f3b2a';
                        el.style.borderColor = '#2dd4bf';
                        el.style.color = '#7ef0ba';
                    }
                });
                // 改变域名block下面的状态提示
                const maintDiv = document.querySelector('.card:nth-child(2) .flex-between .badge-warning');
                if (maintDiv && !maintDiv.innerText.includes('已恢复')) {
                    maintDiv.innerHTML = '✅ 权限已恢复 · 正常服务';
                }
                // 进度文本完全最终
                if (percentLabel && !percentLabel.innerText.includes('已结束')) {
                    percentLabel.innerText = '100% 维护完成 · 后台恢复正常';
                }
            } else {
                // 确保维护中状态的文本严谨（避免异步改动过头）
                const warningBadges = document.querySelectorAll('.badge-warning');
                warningBadges.forEach(el => {
                    if (el.innerText.includes('已恢复') || el.innerText.includes('已结束')) {
                        // 当倒计时没结束但被错误修改时还原
                        if (!el.innerText.includes('维护中')) {
                            el.innerHTML = '⏳ 维护中 / 计划变更';
                            el.style.background = '#2c2416';
                            el.style.borderColor = '#f97330';
                            el.style.color = '#ffb347';
                        }
                    } else if (!el.innerText.includes('维护中') && el.innerText.trim() !== '⏳ 维护中 / 计划变更') {
                        el.innerHTML = '⏳ 维护中 / 计划变更';
                    }
                });
                // 同步更新第2卡片内可能有元素变化
                const altMaint = document.querySelector('.card:nth-child(2) .badge-warning');
                if (altMaint && altMaint.innerText !== '⏳ 维护中 / 计划变更') {
                    altMaint.innerHTML = '⏳ 维护中 / 计划变更';
                }
            }
        }
        
        // 额外保证CS设备始终显示“运行中”，不受维护影响（符合业务，后台仅权限维护）
        // 确保每次刷新时CS设备运行状态文案绝对正确
        function enforceCSStatus() {
            const csStatusDiv = document.querySelector('.cs-status .status-text');
            if (csStatusDiv && csStatusDiv.innerText !== '● 运行中') {
                csStatusDiv.innerText = '● 运行中';
            }
            const csSub = document.querySelector('.cs-status .status-sub');
            if (csSub && !csSub.innerText.includes('核心服务')) {
                csSub.innerText = '核心服务 / 容器集群 · 全绿健康';
            }
        }
        
        // 启动实时刷新(每秒更新)
        let interval = setInterval(() => {
            updateDashboard();
            enforceCSStatus();
        }, 1000);
        
        // 初始化立即执行一次
        updateDashboard();
        enforceCSStatus();
        
        // 附加手动处理当页面可见性变化时无需额外操作，但确保时间精确
        // 监听时区或系统时间篡改不影响逻辑 (基于客户端时间，符合常规看板语义)
        // 优雅处理: 在页面卸载前清除定时器
        window.addEventListener('beforeunload', () => {
            if (interval) clearInterval(interval);
        });
        
        // 如果最终维护结束时间显示“缓存已完成”，增加额外样式让域名卡片显示情况
        // 同时也把预计结束时间的文字略作点缀，不需要多余动作
        // 另外显示后台的“当前平台域名929.com后台权限维护中”确保静态内容与动态倒计时一致
        // 卡片第二块已经包含了"后台权限维护状态" 和 "维护中"样式
        // 根据倒计时结束时，变化badge，已包含
        
        // 强制修复因为倒计时跨天导致的某个进度条边界
        setInterval(() => {
            const nowDate = new Date();
            if (nowDate >= endDate) {
                // 确保所有维护中标记修正一次
                const badges = document.querySelectorAll('.badge-warning');
                badges.forEach(b => {
                    if (b.innerText !== '✅ 权限已恢复') {
                        b.innerHTML = '✅ 权限已恢复';
                        b.style.background = '#0f3b2a';
                    }
                });
                const progFill = document.getElementById('progressFill');
                if (progFill && progFill.style.width !== '100%') progFill.style.width = '100%';
                if (percentLabel && !percentLabel.innerText.includes('100%')) percentLabel.innerText = '100% 缓存完成';
                if (countdownElem) countdownElem.innerText = '✅ 缓存已完成';
            }
        }, 500);
    })();
</script>
</body>
</html>
