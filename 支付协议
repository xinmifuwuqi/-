def check_payment_permission():
    """
    检查支付协议状态，判断是否处于免密支付阶段
    """
    # 设置时区（中国标准时间）
    china_tz = pytz.timezone('Asia/Shanghai')
    current_time = datetime.datetime.now(china_tz)
    
    # 获取当前时间信息
    current_hour = current_time.hour
    current_minute = current_time.minute
    current_time_str = current_time.strftime("%H:%M:%S")
    
    # 免密支付时间段：22:00 - 23:30
    free_payment_start = datetime.time(22, 0, 0)
    free_payment_end = datetime.time(23, 30, 0)
    
    # 将当前时间转换为time对象进行比较
    current_time_obj = datetime.time(current_hour, current_minute)
    
    print("=" * 60)
    print("支付协议状态检查")
    print("=" * 60)
    print(f"当前系统时间: {current_time.strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"当前时间: {current_time_str}")
    print(f"免密支付时段: 22:00 - 23:30")
    print("-" * 60)
    
    # 检查是否在免密支付时段
    if free_payment_start <= current_time_obj <= free_payment_end:
        print("✅ 当前处于免密支付阶段")
        print("✅ 您可以正常提交支付请求")
        
        # 计算剩余免密时间
        end_time_today = china_tz.localize(
            datetime.datetime.combine(current_time.date(), free_payment_end)
        )
        time_left = end_time_today - current_time
        hours, remainder = divmod(time_left.seconds, 3600)
        minutes, seconds = divmod(remainder, 60)
        
        print(f"⏰ 免密支付剩余时间: {hours}小时{minutes}分钟")
        print("=" * 60)
        
        return True
    else:
        print("⚠️  当前未处于免密阶段")
        print("❌ 请等待免密阶段 22:00-23:30 提交")
        print("🔑 或者登陆 DC 管理员账户确认通过")
        print("-" * 60)
        
        # 计算距离免密阶段开始的时间
        # 如果当前时间在免密阶段之后，计算到明天的免密时间
        if current_time_obj > free_payment_end:
            # 明天的时间
            tomorrow = current_time.date() + datetime.timedelta(days=1)
            next_start = china_tz.localize(
                datetime.datetime.combine(tomorrow, free_payment_start)
            )
        else:
            # 今天的时间
            next_start = china_tz.localize(
                datetime.datetime.combine(current_time.date(), free_payment_start)
            )
        
        time_until_start = next_start - current_time
        hours, remainder = divmod(time_until_start.seconds, 3600)
        minutes, seconds = divmod(remainder, 60)
        
        print(f"⏳ 距离下次免密阶段开始还有: {hours}小时{minutes}分钟")
        print("=" * 60)
        
        return False

