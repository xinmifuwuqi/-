# 添加一个测试功能，可以模拟不同时间
def test_specific_time(test_hour, test_minute):
    """
    测试特定时间的支付协议状态
    """
    print("\n" + "=" * 60)
    print(f"测试时间: {test_hour:02d}:{test_minute:02d}")
    print("=" * 60)
    
    # 创建测试时间
    china_tz = pytz.timezone('Asia/Shanghai')
    now = datetime.datetime.now(china_tz)
    test_time = now.replace(hour=test_hour, minute=test_minute, second=0)
    
    # 临时修改当前时间（仅用于测试）
    import datetime as dt
    
    class MockDateTime:
        @classmethod
        def now(cls, tz=None):
            return test_time
    
    # 保存原来的datetime
    original_datetime = datetime.datetime
    
    try:
        # 临时替换datetime
        datetime.datetime = MockDateTime
        
        # 运行检查
        check_payment_permission()
        
    finally:
        # 恢复原来的datetime
        datetime.datetime = original_datetime

