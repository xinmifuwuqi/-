<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>星链Wi-Fi连接监控系统</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Arial, sans-serif;
        }
        
        body {
            background-color: #0a0e17;
            color: #e0f0ff;
            min-height: 100vh;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(41, 83, 156, 0.15) 0%, transparent 20%),
                radial-gradient(circle at 90% 80%, rgba(56, 152, 236, 0.1) 0%, transparent 20%),
                radial-gradient(circle at 50% 50%, rgba(24, 56, 105, 0.2) 0%, transparent 50%);
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }
        
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            margin-bottom: 30px;
            border-bottom: 1px solid rgba(56, 152, 236, 0.3);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .logo-icon {
            color: #2a7fff;
            font-size: 2.5rem;
            filter: drop-shadow(0 0 10px rgba(42, 127, 255, 0.5));
        }
        
        .logo-text {
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(to right, #2a7fff, #6cb4ff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: 1px;
        }
        
        .logo-subtext {
            font-size: 0.9rem;
            color: #8cb4ff;
            margin-top: 5px;
            letter-spacing: 3px;
        }
        
        .status-indicator {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(20, 40, 80, 0.5);
            padding: 10px 20px;
            border-radius: 50px;
            border: 1px solid rgba(56, 152, 236, 0.3);
        }
        
        .status-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: #4cff4c;
            box-shadow: 0 0 10px #4cff4c;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }
        
        .main-panel {
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 25px;
            margin-bottom: 30px;
        }
        
        .stats-card {
            background: linear-gradient(145deg, rgba(16, 33, 68, 0.8), rgba(10, 22, 46, 0.8));
            border-radius: 15px;
            padding: 25px;
            border: 1px solid rgba(56, 152, 236, 0.2);
            box-shadow: 0 10px 30px rgba(0, 20, 60, 0.3);
        }
        
        .stats-header {dollet.cll已经写入监控正在加载端口}
         大约需要1小时
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }
        
        .stats-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #6cb4ff;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }
        
        .stat-item {
            text-align: center;
            padding: 20px;
            background: rgba(20, 40, 80, 0.3);
            border-radius: 12px;
            border: 1px solid rgba(56, 152, 236, 0.1);
        }
        
        .stat-value {
            font-size: 2.5rem;
            font-weight: 700;
            color: #2a7fff;
            margin-bottom: 5px;
        }
        
        .stat-label {
            font-size: 0.9rem;
            color: #8cb4ff;
        }
        
        .devices-card {
            background: linear-gradient(145deg, rgba(16, 33, 68, 0.8), rgba(10, 22, 46, 0.8));
            border-radius: 15px;
            padding: 25px;
            border: 1px solid rgba(56, 152, 236, 0.2);
            box-shadow: 0 10px 30px rgba(0, 20, 60, 0.3);
            overflow: hidden;
        }
        
        .devices-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }
        
        .devices-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #6cb4ff;
        }
        
        .device-count {
            background: rgba(56, 152, 236, 0.2);
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
        }
        
        .devices-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
            max-height: 500px;
            overflow-y: auto;
            padding-right: 10px;
        }
        
        .device-item {
            background: rgba(20, 40, 80, 0.3);
            border-radius: 12px;
            padding: 18px;
            display: flex;
            align-items: center;
            gap: 15px;
            border: 1px solid rgba(56, 152, 236, 0.1);
            transition: all 0.3s ease;
        }
        
        .device-item:hover {
            background: rgba(30, 60, 120, 0.4);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 20, 60, 0.4);
        }
        
        .device-icon {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(42, 127, 255, 0.1);
            border-radius: 10px;
            font-size: 1.5rem;
            color: #6cb4ff;
        }
        
        .device-info {
            flex-grow: 1;
        }
        
        .device-name {
            font-weight: 600;
            margin-bottom: 5px;
            color: #e0f0ff;
        }
        
        .device-type {
            font-size: 0.85rem;
            color: #8cb4ff;
        }
        
        .device-extra {
            font-size: 0.7rem;
            color: #6cb4ff;
            margin-top: 3px;
        }
        
        .device-status {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 5px;
        }
        
        .status-connected {
            color: #4cff4c;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        
        .status-offline {
            color: #ff5555;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        
        .offline-time {
            font-size: 0.75rem;
            color: #ffaaaa;
            margin-top: 3px;
        }
        
        .signal-strength {
            display: flex;
            align-items: center;
            gap: 3px;
        }
        
        .signal-bar {
            width: 4px;
            height: 10px;
            background-color: rgba(255, 255, 255, 0.2);
            border-radius: 2px;
        }
        
        .signal-bar.active {
            background-color: #4cff4c;
        }
        
        .control-panel {
            background: linear-gradient(145deg, rgba(16, 33, 68, 0.8), rgba(10, 22, 46, 0.8));
            border-radius: 15px;
            padding: 25px;
            border: 1px solid rgba(56, 152, 236, 0.2);
            box-shadow: 0 10px 30px rgba(0, 20, 60, 0.3);
        }
        
        .control-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #6cb4ff;
            margin-bottom: 25px;
        }
        
        .control-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 25px;
        }
        
        .control-btn {
            padding: 15px;
            border-radius: 10px;
            border: none;
            background: rgba(42, 127, 255, 0.2);
            color: #e0f0ff;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border: 1px solid rgba(56, 152, 236, 0.2);
        }
        
        .control-btn:hover {
            background: rgba(42, 127, 255, 0.4);
            transform: translateY(-2px);
        }
        
        .speed-test {
            background: rgba(20, 40, 80, 0.3);
            padding: 20px;
            border-radius: 12px;
            margin-top: 20px;
        }
        
        .speed-title {
            font-size: 1rem;
            color: #8cb4ff;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
        }
        
        .speed-bar {
            height: 10px;
            background: rgba(20, 40, 80, 0.5);
            border-radius: 5px;
            overflow: hidden;
            margin-bottom: 10px;
        }
        
        .speed-fill {
            height: 100%;
            background: linear-gradient(to right, #2a7fff, #6cb4ff);
            width: 85%;
            border-radius: 5px;
        }
        
        .speed-values {
            display: flex;
            justify-content: space-between;
            font-size: 0.9rem;
            color: #8cb4ff;
        }
        
        .status-tag {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-left: 8px;
        }
        
        .status-online {
            background-color: rgba(76, 255, 76, 0.2);
            color: #4cff4c;
        }
        
        .status-offline-tag {
            background-color: rgba(255, 85, 85, 0.2);
            color: #ff5555;
        }
        
        .offline-marker {
            display: inline-block;
            padding: 2px 6px;
            background-color: rgba(255, 85, 85, 0.1);
            color: #ffaaaa;
            border-radius: 8px;
            font-size: 0.65rem;
            margin-left: 5px;
            border: 1px solid rgba(255, 85, 85, 0.3);
        }
        
        footer {
            text-align: center;
            padding: 20px;
            margin-top: 30px;
            border-top: 1px solid rgba(56, 152, 236, 0.3);
            color: #8cb4ff;
            font-size: 0.9rem;
        }
        
        @media (max-width: 1100px) {
            .main-panel {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 768px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
            .control-buttons {
                grid-template-columns: 1fr;
            }
            header {
                flex-direction: column;
                align-items: flex-start;
                gap: 20px;
            }
        }
        
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(20, 40, 80, 0.3);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(42, 127, 255, 0.5);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(42, 127, 255, 0.7);
        }
        
        .stars {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
        }
        .star {
            position: absolute;
            background-color: white;
            border-radius: 50%;
            animation: twinkle 5s infinite;
        }
        @keyframes twinkle {
            0% { opacity: 0.2; }
            50% { opacity: 1; }
            100% { opacity: 0.2; }
        }
    </style>
</head>
<body>
    <div class="stars" id="stars"></div>
    
    <div class="container">
        <header>
            <div class="logo">
                <div class="logo-icon"><i class="fas fa-satellite"></i></div>
                <div>
                    <div class="logo-text">星链Wi-Fi监控系统</div>
