    <script>
        // 设备数据 - 根据最新要求更新
        const devices = [
            // 手机设备
            { name: "大卫哥的iPhone", type: "iPhone 15 Pro", signal: 0, connected: false, offlineTime: "08:33" },
            { name: "秦&iPhone 17 Pro Max", type: "iPhone 17 Pro Max", signal: 5, connected: true },
            { name: "璐的iPhone 16 Pro", type: "iPhone 16 Pro", signal: 0, connected: false, offlineTime: "06:19" },
            { name: "小石头的HUA WEI Mate 70RS", type: "HUAWEI Mate 70RS", signal: 5, connected: true },
            { name: "iPhone", type: "iPhone 14", signal: 5, connected: true },
            { name: "王宝军的HUA WEI Mate XT", type: "HUAWEI Mate XT", signal: 0, connected: false, offlineTime: "03:12" },
            
            // 7台华为电脑：6台在线，1台离线（AL00 离线 3:10）
            { name: "HUAWEI-PAL-AL00", type: "华为电脑", signal: 0, connected: false, offlineTime: "03:10" },
            { name: "HUAWEI-PAL-AL13", type: "华为电脑", signal: 5, connected: true },
            { name: "HUAWEI-PAL-PT51", type: "华为电脑", signal: 5, connected: true },
            { name: "HUAWEI-PAL-AL19", type: "华为电脑", signal: 5, connected: true },
            { name: "HUAWEI-PAL-AL27", type: "华为电脑", signal: 5, connected: true },
            { name: "HUAWEI-PAL-AL34", type: "华为电脑", signal: 5, connected: true },
            { name: "HUAWEI-PAL-AL42", type: "华为电脑", signal: 5, connected: true },
            
            // 新增设备
            { name: "小米监控", type: "智能摄像头", extra: "IP: 192.168.1.1 (香港)", signal: 5, connected: true },
            { name: "VMware", type: "虚拟机", extra: "可用", signal: 5, connected: true }
        ];
        
        // 生成星空背景
        function createStars() {
            const starsContainer = document.getElementById('stars');
            for (let i = 0; i < 150; i++) {
                const star = document.createElement('div');
                star.classList.add('star');
                const size = Math.random() * 3;
                const x = Math.random() * 100;
                const y = Math.random() * 100;
                const duration = 2 + Math.random() * 3;
                const delay = Math.random() * 5;
                star.style.width = `${size}px`;
                star.style.height = `${size}px`;
                star.style.left = `${x}%`;
                star.style.top = `${y}%`;
                star.style.animationDuration = `${duration}s`;
                star.style.animationDelay = `${delay}s`;
                starsContainer.appendChild(star);
            }
        }
        
        // 渲染设备列表
        function renderDevices() {
            const devicesList = document.getElementById('devicesList');
            devicesList.innerHTML = '';
            
            let onlineCount = devices.filter(d => d.connected).length;
            document.getElementById('onlineStatusText').textContent = `在线 · ${onlineCount}台设备已连接`;
            
            devices.forEach(device => {
                let iconClass = "fas fa-mobile-alt";
                if (device.type.includes("电脑")) iconClass = "fas fa-laptop";
                else if (device.type === "智能摄像头") iconClass = "fas fa-video";
                else if (device.type === "虚拟机") iconClass = "fas fa-server";
                else if (device.type.includes("HUAWEI Mate")) iconClass = "fas fa-mobile-alt";
                
                // 信号强度条
                let signalBars = '';
                for (let i = 1; i <= 5; i++) {
                    signalBars += `<div class="signal-bar ${i <= device.signal ? 'active' : ''}"></div>`;
                }
                
                let statusHtml = '';
                if (device.connected) {
                    statusHtml = `
                        <div class="status-connected">
                            <i class="fas fa-circle" style="font-size: 0.6rem;"></i>
                            在线
                        </div>
                        <div class="signal-strength">${signalBars}</div>
                    `;
                } else {
                    statusHtml = `
                        <div class="status-offline">
                            <i class="fas fa-circle" style="font-size: 0.6rem;"></i>
                            离线
                        </div>
                        <div class="offline-time">离线时间：${device.offlineTime}</div>
                    `;
                }
                
                let statusTag = '';
                if (device.connected && (device.name === "秦&iPhone 17 Pro Max" || device.name === "iPhone" || device.name === "小石头的HUA WEI Mate 70RS")) {
                    statusTag = '<span class="status-tag status-online">在线</span>';
                } else if (!device.connected) {
                    statusTag = '<span class="status-tag status-offline-tag">离线</span>';
                }
                
                let offlineMarker = '';
                if (!device.connected && device.offlineTime) {
                    offlineMarker = `<span class="offline-marker">${device.offlineTime}离线</span>`;
                }
                
                let extraHtml = device.extra ? `<div class="device-extra"><i class="fas fa-info-circle"></i> ${device.extra}</div>` : '';
                
                const deviceElement = document.createElement('div');
                deviceElement.className = 'device-item';
                deviceElement.innerHTML = `
                    <div class="device-icon"><i class="${iconClass}"></i></div>
                    <div class="device-info">
                        <div class="device-name">${device.name}${statusTag}${offlineMarker}</div>
                        <div class="device-type">${device.type}</div>
                        ${extraHtml}
                    </div>
                    <div class="device-status">${statusHtml}</div>
                `;
                devicesList.appendChild(deviceElement);
            });
        }
        
        // 网速模拟
        function updateSpeed() {
            const baseSpeed = 855;
            const variation = Math.floor(Math.random() * 30) - 15;
            const newSpeed = baseSpeed + variation;
            document.getElementById('downloadSpeed').textContent = newSpeed;
            document.getElementById('downloadSpeedBar').style.width = `${(newSpeed / 1000) * 100}%`;
            const baseLatency = 28;
            const latencyVariation = Math.floor(Math.random() * 10) - 5;
            const newLatency = Math.max(20, baseLatency + latencyVariation);
            document.getElementById('latency').textContent = newLatency;
        }
        
        // 重新连接（模拟）
        function reconnectDevice(deviceIndex) {
            devices[deviceIndex].connected = true;
            devices[deviceIndex].signal = Math.floor(Math.random() * 3) + 3;
            renderDevices();
            showNotification(`${devices[deviceIndex].name} 已重新连接`);
        }
        
        function showNotification(message) {
            const notification = document.createElement('div');
            notification.style.cssText = `
                position: fixed; top: 20px; right: 20px; background: rgba(20,40,80,0.9);
                color: #e0f0ff; padding: 15px 20px; border-radius: 10px;
                border-left: 5px solid #2a7fff; box-shadow: 0 5px 15px rgba(0,0,0,0.3);
                z-index: 1000; transform: translateX(120%); transition: transform 0.3s ease;
                max-width: 300px; font-weight: 500;
            `;
            notification.textContent = message;
            document.body.appendChild(notification);
            setTimeout(() => { notification.style.transform = 'translateX(0)'; }, 10);
            setTimeout(() => {
                notification.style.transform = 'translateX(120%)';
                setTimeout(() => document.body.removeChild(notification), 300);
            }, 3000);
        }
        
        function setupEventListeners() {
            document.getElementById('refreshBtn').addEventListener('click', function() {
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 扫描中...';
                setTimeout(() => {
                    this.innerHTML = '<i class="fas fa-sync-alt"></i> 刷新设备';
                    const randomIndex = Math.floor(Math.random() * devices.length);
                    const newSignal = Math.floor(Math.random() * 3) + 3;
                    devices[randomIndex].signal = newSignal;
                    renderDevices();
                    showNotification(`设备扫描完成，更新了${devices[randomIndex].name}的信号强度`);
                }, 1500);
            });
            document.getElementById('blockAllBtn').addEventListener('click', function() {
                this.innerHTML = '<i class="fas fa-shield-alt"></i> 扫描中...';
                setTimeout(() => {
                    this.innerHTML = '<i class="fas fa-shield-alt"></i> 安全扫描';
                    showNotification('安全扫描完成，未发现威胁设备');
                }, 2000);
            });
            document.getElementById('optimizeBtn').addEventListener('click', function() {
                this.innerHTML = '<i class="fas fa-cog fa-spin"></i> 优化中...';
                setTimeout(() => {
                    this.innerHTML = '<i class="fas fa-tachometer-alt"></i> 优化网络';
                    const speedEl = document.getElementById('downloadSpeed');
                    let newSpeed = parseInt(speedEl.textContent) + Math.floor(Math.random() * 50) + 20;
                    speedEl.textContent = newSpeed;
                    document.getElementById('downloadSpeedBar').style.width = `${(newSpeed / 1000) * 100}%`;
                    showNotification('网络优化完成，下载速度提升');
                }, 1800);
            });
            document.getElementById('restartBtn').addEventListener('click', function() {
                this.innerHTML = '<i class="fas fa-power-off"></i> 重启中...';
                this.disabled = true;
                setTimeout(() => {
                    this.innerHTML = '<i class="fas fa-power-off"></i> 重启路由器';
                    this.disabled = false;
                    devices.forEach(d => { d.connected = true; d.signal = Math.min(5, d.signal + 1); });
                    renderDevices();
                    showNotification('路由器重启完成，所有设备已重新连接');
                }, 3000);
            });
            
            // 点击离线设备重新连接
            document.getElementById('devicesList').addEventListener('click', function(e) {
                const item = e.target.closest('.device-item');
                if (!item) return;
                const nameElem = item.querySelector('.device-name');
                let rawName = nameElem.textContent.replace(/在线|离线|\(.*?\)/g, '').replace(/\d+:\d+离线/g, '').trim();
                const idx = devices.findIndex(d => d.name === rawName);
                if (idx !== -1 && !devices[idx].connected) {
                    reconnectDevice(idx);
                }
            });
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            createStars();
            renderDevices();
            setupEventListeners();
            setInterval(updateSpeed, 10000);
            updateSpeed();
        });
    </script>
</body>
</html>
