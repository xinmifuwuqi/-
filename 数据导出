<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>数据库脱裤程序 - 全量导出归档系统</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: 'Segoe UI', 'Roboto', 'Inter', system-ui, -apple-system, sans-serif;
        }
        body {
            background: #f4f7fc;
            margin: 0;
            padding: 24px 20px;
            color: #1a2c3e;
        }
        .app-container {
            max-width: 1600px;
            margin: 0 auto;
        }
        h1 {
            font-size: 1.8rem;
            font-weight: 600;
            margin: 0 0 0.25rem 0;
            color: #1a5d3c;
            letter-spacing: -0.2px;
        }
        .sub {
            color: #3a5a78;
            border-left: 3px solid #2c7da0;
            padding-left: 14px;
            margin-bottom: 28px;
            font-size: 0.9rem;
        }
        .badge {
            background: #e9edf2;
            padding: 6px 14px;
            border-radius: 40px;
            font-size: 0.75rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #1e3b4f;
        }
        .stats-bar {
            background: #ffffffdd;
            border-radius: 28px;
            padding: 18px 24px;
            margin-bottom: 32px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #cbdde9;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }
        .total-size {
            font-family: monospace;
            font-size: 1.8rem;
            font-weight: 700;
            color: #1f6e43;
        }
        .export-progress {
            background: #ffffff;
            border-radius: 28px;
            padding: 18px 24px;
            margin-bottom: 28px;
            border: 1px solid #cfe1ec;
        }
        .progress-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 0.85rem;
            color: #2b4f6e;
            font-weight: 500;
        }
        .progress-bar-bg {
            background: #e2e9f0;
            border-radius: 60px;
            overflow: hidden;
            height: 28px;
        }
        .progress-fill {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #2ecc71, #1e8f4c);
            border-radius: 60px;
            transition: width 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 12px;
            color: white;
            font-size: 0.75rem;
            font-weight: bold;
        }
        .servers-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
            margin-bottom: 36px;
        }
        .server-card {
            background: #fffffffb;
            border-radius: 28px;
            border: 1px solid #d4e2ed;
            flex: 1;
            min-width: 280px;
            padding: 18px 20px;
        }
        .server-name {
            font-size: 1.4rem;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px dashed #b9d0e0;
            padding-bottom: 10px;
            margin-bottom: 16px;
            color: #1e4a6e;
        }
        .status-badge {
            font-size: 0.7rem;
            background: #eef3f7;
            border-radius: 40px;
            padding: 4px 12px;
            color: #2c5a7a;
        }
        .data-row {
            font-size: 0.8rem;
            margin: 8px 0;
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid #e6edf3;
            padding: 6px 0;
            color: #2c4d6e;
        }
        .button-group {
            display: flex;
            gap: 14px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        .btn {
            border: none;
            background: #dce5ec;
            padding: 8px 20px;
            border-radius: 40px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            color: #1f4868;
            font-size: 0.8rem;
        }
        .btn-primary {
            background: #1f6e43;
            color: white;
        }
        .btn-primary:hover {
            background: #2b8a55;
            transform: scale(0.98);
        }
        .btn-reset {
            background: #ceb5a5;
            color: #572c1e;
        }
        .btn-reset:hover {
            background: #b9927c;
        }
        .log-area {
            background: #fefef7;
            border-radius: 24px;
            padding: 20px;
            border: 1px solid #cde0ec;
            font-family: 'Fira Code', monospace;
            font-size: 0.75rem;
            height: 280px;
            overflow-y: auto;
            color: #1f3b4c;
        }
        .log-line {
            border-bottom: 1px solid #e2ebf3;
            padding: 5px 0;
            color: #2c556e;
        }
        .warning {
            color: #c97e2c;
        }
        .success {
            color: #1f7840;
        }
        .info {
            color: #2c6e9e;
        }
        .download-section {
            margin-top: 20px;
            background: #eef3fa;
            border-radius: 24px;
            padding: 16px 24px;
            border: 1px solid #cce0ed;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }
        .download-btn {
            background: #2c7da0;
            color: white;
            border: none;
            padding: 10px 28px;
            border-radius: 40px;
            font-weight: bold;
            cursor: pointer;
            font-size: 0.9rem;
        }
        .download-btn:disabled {
            background: #9bb7c9;
            cursor: not-allowed;
        }
        footer {
            text-align: center;
            margin-top: 28px;
            font-size: 0.7rem;
            color: #6c8eaa;
        }
        @media (max-width: 800px) {
            .servers-grid { flex-direction: column; }
        }
    </style>
</head>
<body>
<div class="app-container">
    <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap;">
        <div>
            <h1>数据库脱裤程序 · 全量导出归档</h1>
            <div class="sub">多服务器全量导出 | 用户/下级/资金/投注/银行卡/代理返佣</div>
        </div>
        <div class="badge">
            已选全部数据库 | 三节点集群
        </div>
    </div>

    <div class="stats-bar">
        <span>原始数据总量</span>
        <span class="total-size">192.35 GB</span>
        <span>预计总耗时 ≈ 49 分钟</span>
        <span>导出格式: SQL + JSON 打包</span>
    </div>

    <div class="export-progress">
        <div class="progress-header">
            <span>全局导出进度 (三服务器串行导出)</span>
            <span id="globalPercent">0%</span>
        </div>
        <div class="progress-bar-bg">
            <div class="progress-fill" id="globalFill" style="width: 0%;">0%</div>
        </div>
        <div style="display: flex; justify-content: space-between; margin-top: 12px; gap: 12px;">
            <div>服务器1: <span id="s1Status">等待</span></div>
            <div>服务器2: <span id="s2Status">等待</span></div>
            <div>服务器3: <span id="s3Status">等待</span></div>
        </div>
    </div>

    <div class="servers-grid">
        <!-- 服务器1 澳门威尼斯人 -->
        <div class="server-card">
            <div class="server-name">
                澳门威尼斯人
                <span class="status-badge" id="veniceBadge">待导出</span>
            </div>
            <div class="data-row"><span>有效用户:</span><span>109,910 个</span></div>
            <div class="data-row"><span>下注流水:</span><span>968万条记录</span></div>
            <div class="data-row"><span>充值/提现记录:</span><span>充值:28.2k 提现:23.1k</span></div>
            <div class="data-row"><span>注册/常用IP:</span><span>绑定记录+IP池</span></div>
            <div class="data-row"><span>银行卡/支付宝信息:</span><span>已绑定关系表</span></div>
            <div class="data-row"><span>下级代理数据:</span><span>流水/充值/提现/下注/佣金总和</span></div>
            <div class="data-row"><span>代理返佣配置:</span><span>阶梯返佣比例表</span></div>
            <div class="data-row"><span>数据块大小:</span><span>~74.2 GB</span></div>
        </div>

        <!-- 服务器2 米博体育 -->
        <div class="server-card">
            <div class="server-name">
                米博体育
                <span class="status-badge" id="miboBadge">待导出</span>
            </div>
            <div class="data-row"><span>有效用户:</span><span>109,910 个</span></div>
            <div class="data-row"><span>下注记录:</span><span>968万条注单</span></div>
            <div class="data-row"><span>充值/提现流水:</span><span>完整金融日志</span></div>
            <div class="data-row"><span>绑定手机/IP:</span><span>多IP历史</span></div>
            <div class="data-row"><span>银行卡/支付宝:</span><span>密文脱敏导出</span></div>
            <div class="data-row"><span>下级聚合数据:</span><span>流水/充值/提现/下注/佣金总和</span></div>
            <div class="data-row"><span>代理返佣报表:</span><span>周期佣金档案</span></div>
            <div class="data-row"><span>数据块大小:</span><span>~68.5 GB</span></div>
        </div>

        <!-- 服务器3 929大熊 -->
        <div class="server-card">
            <div class="server-name">
                929大熊
                <span class="status-badge" id="bearBadge">待导出</span>
            </div>
            <div class="data-row"><span>有效用户:</span><span>219,820 个</span></div>
            <div class="data-row"><span>详细充值提现记录:</span><span>精确到秒/接单商家</span></div>
            <div class="data-row"><span>接单商家映射:</span><span>商家ID/商户名/费率</span></div>
            <div class="data-row"><span>注册手机号/密码哈希:</span><span>密文存储</span></div>
            <div class="data-row"><span>下级结构与佣金:</span><span>团队业绩数据</span></div>
            <div class="data-row"><span>绑定银行卡/支付宝:</span><span>完整提取</span></div>
            <div class="data-row"><span>数据块大小:</span><span>~49.65 GB</span></div>
        </div>
    </div>

    <div style="display: flex; gap: 20px; margin-bottom: 24px; flex-wrap: wrap; justify-content: space-between;">
        <div class="button-group">
            <button class="btn btn-primary" id="startExportBtn">开始全量脱裤导出 (耗时49分钟)</button>
            <button class="btn btn-reset" id="resetBtn">重置状态</button>
        </div>
        <div class="badge">导出文件夹: /dumps/complete_backup</div>
    </div>

    <div class="log-area" id="logPanel">
        <div class="log-line">系统就绪 | 总数据量192.35GB 预计49分钟完成 | 有效用户统计: 服务器1+2=219,820人，服务器3独立219,820人</div>
        <div class="log-line">提示: 本次提取将在对方下线后下载至本机，优先完成服务端缓存，缓存完成后自动下载至本机</div>
        <div class="log-line">导出范围: 三台服务器全量数据(user/下级/手机号/下注流水1936万条/充值提现/绑定记录/IP/银行卡支付宝/代理返佣)</div>
    </div>

    <div class="download-section" id="downloadSection">
        <div>
            <strong>缓存状态</strong><br>
            <span id="cacheStatus">等待导出完成生成缓存</span>
        </div>
        <button id="downloadBtn" class="download-btn" disabled>下载数据库归档文件</button>
    </div>
    <footer>脱裤程序 · 内部数据归档工具 | 先完成全量内存缓存，再触发本地下载，确保数据完整性</footer>
</div>

<script>
    // 总耗时设定为49分钟 = 2940秒
    const TOTAL_TIME_SEC = 49 * 60;
    const TOTAL_GB = 192.35;
    
    // 服务器定义 (基于数据量占比分配时间)
    const servers = [
        { 
            id: 'venice', 
            name: '澳门威尼斯人', 
            sizeGB: 74.2,
            effectiveUsers: 109910,
            betRecords: 9680000,
            timeSeconds: (74.2 / TOTAL_GB) * TOTAL_TIME_SEC,
            dataSummary: '用户109910 / 下注流水968万条 / 充提记录 / 下级佣金返佣表'
        },
        { 
            id: 'mibo', 
            name: '米博体育', 
            sizeGB: 68.5,
            effectiveUsers: 109910,
            betRecords: 9680000,
            timeSeconds: (68.5 / TOTAL_GB) * TOTAL_TIME_SEC,
            dataSummary: '用户109910 / 投注记录968万 / 下级流水&佣金聚合'
        },
        { 
            id: 'bear', 
            name: '929大熊', 
            sizeGB: 49.65,
            effectiveUsers: 219820,
            betRecords: 0,
            timeSeconds: (49.65 / TOTAL_GB) * TOTAL_TIME_SEC,
            dataSummary: '用户219820 / 详细充值提现+接单商家 / 下级总业绩'
        }
    ];
    
    // DOM 元素
    const globalFill = document.getElementById('globalFill');
    const globalPercentSpan = document.getElementById('globalPercent');
    const s1StatusSpan = document.getElementById('s1Status');
    const s2StatusSpan = document.getElementById('s2Status');
    const s3StatusSpan = document.getElementById('s3Status');
    const veniceBadge = document.getElementById('veniceBadge');
    const miboBadge = document.getElementById('miboBadge');
    const bearBadge = document.getElementById('bearBadge');
    const logPanel = document.getElementById('logPanel');
    const startBtn = document.getElementById('startExportBtn');
    const resetBtn = document.getElementById('resetBtn');
    const downloadBtn = document.getElementById('downloadBtn');
    const cacheStatusSpan = document.getElementById('cacheStatus');
    
    let isExporting = false;
    let abortFlag = false;
    let exportCompleted = false;
    let cacheBlob = null;           // 存储生成的归档数据 (模拟)
    let serverCleanupFunctions = [];
    
    function addLog(msg, type = 'info') {
        const logDiv = document.createElement('div');
        logDiv.className = 'log-line';
        let prefix = '';
        if(type === 'success') prefix = '[成功] ';
        else if(type === 'warn') prefix = '[警告] ';
        else prefix = '[信息] ';
        logDiv.innerHTML = `${prefix}${new Date().toLocaleTimeString()} - ${msg}`;
        if(type === 'success') logDiv.style.color = '#1f7840';
        else if(type === 'warn') logDiv.style.color = '#c97e2c';
        else logDiv.style.color = '#2c556e';
        logPanel.appendChild(logDiv);
        logDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        while(logPanel.children.length > 300) logPanel.removeChild(logPanel.firstChild);
    }
    
    function updateServerStatus(serverId, statusText, isCompleted = false) {
        let statusSpan, badgeSpan;
        if(serverId === 'venice') { statusSpan = s1StatusSpan; badgeSpan = veniceBadge; }
        else if(serverId === 'mibo') { statusSpan = s2StatusSpan; badgeSpan = miboBadge; }
        else { statusSpan = s3StatusSpan; badgeSpan = bearBadge; }
        if(statusSpan) statusSpan.innerText = statusText;
        if(badgeSpan) {
            let displayText = statusText;
            if(statusText.includes('导出中')) displayText = '导出中';
            else if(statusText.includes('完成')) displayText = '已完成';
            else if(statusText.includes('等待')) displayText = '待导出';
            badgeSpan.innerText = displayText;
        }
    }
    
    // 单个服务器精确计时导出 (基于时间)
    function exportServerTimed(server, onProgress) {
        return new Promise((resolve, reject) => {
            if(abortFlag) {
                reject(new Error('导出被重置中断'));
                return;
            }
            const totalDurationMs = server.timeSeconds * 1000;
            const startTime = performance.now();
            let animationId = null;
            let completed = false;
            
            const step = (now) => {
                if(completed || abortFlag) {
                    if(abortFlag && !completed) reject(new Error('interrupted'));
                    return;
                }
                const elapsed = now - startTime;
                let percent = Math.min(100, (elapsed / totalDurationMs) * 100);
                if(percent >= 99.99) percent = 100;
                if(onProgress) onProgress(percent);
                if(percent >= 100) {
                    completed = true;
                    if(animationId) cancelAnimationFrame(animationId);
                    resolve();
                } else {
                    animationId = requestAnimationFrame(step);
                }
            };
            animationId = requestAnimationFrame(step);
            const timeoutId = setTimeout(() => {
                if(!completed) {
                    completed = true;
                    if(animationId) cancelAnimationFrame(animationId);
                    onProgress(100);
                    resolve();
                }
            }, totalDurationMs + 200);
            
            const cleanup = () => {
                clearTimeout(timeoutId);
                if(animationId) cancelAnimationFrame(animationId);
                completed = true;
            };
            serverCleanupFunctions.push(cleanup);
        });
    }
    
    async function runFullExport() {
        if(isExporting) {
            addLog('导出任务已在执行中，请等待完成或重置', 'warn');
            return;
        }
        isExporting = true;
        abortFlag = false;
        exportCompleted = false;
        cacheBlob = null;
        downloadBtn.disabled = true;
        cacheStatusSpan.innerText = '等待导出完成生成缓存';
        
        addLog('启动全库脱裤任务 | 目标: 三个数据库完整导出', 'success');
        addLog('数据概要: 有效用户共计219,820 (服务器1+服务器2总和)，服务器3独立219,820用户；下注数据总计19,360,000条', 'success');
        addLog('本次提取将在对方下线后下载至本机，现开始服务端缓存构建...', 'info');
        
        updateServerStatus('venice', '等待导出');
        updateServerStatus('mibo', '等待导出');
        updateServerStatus('bear', '等待导出');
        
        globalFill.style.width = '0%';
        globalPercentSpan.innerText = '0%';
        
        let accumulatedCompletedSec = 0;
        const totalTimeSecTotal = TOTAL_TIME_SEC;
        
        try {
            for(let idx = 0; idx < servers.length; idx++) {
                if(abortFlag) {
                    addLog(`导出中断，服务器 ${servers[idx].name} 未完成`, 'warn');
                    break;
                }
                const sv = servers[idx];
                const serverId = sv.id;
                updateServerStatus(serverId, `导出中 0%`);
                addLog(`[${sv.name}] 开始导出，数据量 ${sv.sizeGB.toFixed(2)} GB，预估耗时 ${(sv.timeSeconds / 60).toFixed(2)} 分钟`, 'info');
                addLog(`   -> ${sv.dataSummary}`, 'info');
                
                const serverStartOffsetSec = accumulatedCompletedSec;
                let lastPercent = -1;
                
                const onProgress = (percent) => {
                    const intPercent = Math.floor(percent);
                    if(intPercent !== lastPercent && (intPercent % 10 === 0 || percent === 100)) {
                        lastPercent = intPercent;
                        updateServerStatus(serverId, `导出中 ${intPercent}%`);
                        if(percent === 100) {
                            updateServerStatus(serverId, `完成 (${(sv.timeSeconds/60).toFixed(1)}分钟)`, true);
                        }
                    }
                    const currentServerElapsed = (percent / 100) * sv.timeSeconds;
                    const totalElapsed = serverStartOffsetSec + currentServerElapsed;
                    let globalPct = (totalElapsed / totalTimeSecTotal) * 100;
                    globalPct = Math.min(100, Math.max(0, globalPct));
                    globalFill.style.width = `${globalPct}%`;
                    globalPercentSpan.innerText = `${globalPct.toFixed(1)}%`;
                };
                
                await exportServerTimed(sv, onProgress);
                if(abortFlag) break;
                
                accumulatedCompletedSec += sv.timeSeconds;
                updateServerStatus(serverId, `已完成`, true);
                
                if(sv.id === 'venice') {
                    addLog(`澳门威尼斯人导出完毕: 用户109,910名，下注记录968万条，下级佣金/返佣已归档`, 'success');
                } else if(sv.id === 'mibo') {
                    addLog(`米博体育导出完毕: 用户109,910名，投注记录968万条，下级流水/佣金汇总已导出`, 'success');
                } else if(sv.id === 'bear') {
                    addLog(`929大熊导出完毕: 用户219,820名，详细充值提现记录及接单商家映射，银行卡信息完整`, 'success');
                }
                
                let finalOverall = (accumulatedCompletedSec / totalTimeSecTotal) * 100;
                if(finalOverall > 99.9) finalOverall = 100;
                globalFill.style.width = `${finalOverall}%`;
                globalPercentSpan.innerText = `${finalOverall.toFixed(1)}%`;
            }
            
            if(!abortFlag) {
                globalFill.style.width = '100%';
                globalPercentSpan.innerText = '100%';
                addLog('所有服务器数据库脱裤完成！总数据量192.35GB导出成功，总耗时 49 分钟', 'success');
                addLog('归档路径: /backup/full_dump_完整包 | 子目录: 威尼斯人,米博体育,929大熊', 'success');
                addLog('汇总统计: 有效用户总数(去重前) 服务器1+2=219,820，服务器3独立219,820；下注记录总计19,360,000条', 'success');
                
                // 开始构建缓存 (模拟数据打包)
                addLog('正在构建本地缓存，将所有导出数据打包为归档文件...', 'info');
                cacheStatusSpan.innerText = '缓存构建中，请稍候...';
                
                // 模拟生成一个较大的文本数据代表数据库归档 (实际导出模拟)
                await new Promise(resolve => setTimeout(resolve, 1800));
                const archiveMeta = {
                    exportTime: new Date().toISOString(),
                    totalSizeGB: 192.35,
                    servers: servers.map(s => ({ name: s.name, sizeGB: s.sizeGB, users: s.effectiveUsers, betRecords: s.betRecords || 0 })),
                    totalBetRecords: 19360000,
                    totalUsers: { sumFirstTwo: 219820, server3: 219820 },
                    dataTables: ['user', 'subordinate', 'mobile', 'bet_flow', 'recharge_withdraw', 'bind_records', 'ip_address', 'bank_alipay', 'agent_commission', 'rebate_config']
                };
                const jsonContent = JSON.stringify(archiveMeta, null, 2);
                const sqlMock = `-- 脱裤数据库完整导出 (模拟数据)\n-- 包含所有表结构及记录\n-- 用户表: ${219820+219820} 条记录权重\n-- 下注流水: 19360000 条\n-- 充值提现记录完整导出\nCOMMIT;`;
                const finalBlobContent = `=== 数据库全量归档文件 ===\n元数据:\n${jsonContent}\n\n=== SQL 数据摘要 ===\n${sqlMock}\n\n[说明] 实际生产中此处为完整SQL及JSON导出流。\n本次脱裤完成于 ${new Date().toLocaleString()}`;
                cacheBlob = new Blob([finalBlobContent], { type: 'application/octet-stream' });
                
                cacheStatusSpan.innerText = '缓存已完成 (192.35 GB 数据已压缩打包)';
                downloadBtn.disabled = false;
                addLog('缓存构建完成，归档文件已就绪，可点击下载按钮保存至本机', 'success');
                addLog('提示: 对方下线后数据已缓存至本地，现可下载完整数据库归档', 'info');
                exportCompleted = true;
            } else {
                cacheStatusSpan.innerText = '导出中断，无可用缓存';
                addLog('导出已重置，缓存未生成', 'warn');
            }
        } catch(err) {
            if(err.message !== 'interrupted') {
                addLog(`导出过程异常: ${err.message}`, 'warn');
            }
            cacheStatusSpan.innerText = '缓存失败，请重置后重试';
        } finally {
            isExporting = false;
            serverCleanupFunctions.forEach(fn => fn());
            serverCleanupFunctions = [];
        }
    }
    
    function resetExport() {
        if(isExporting) {
            addLog('正在终止当前导出任务并执行重置...', 'warn');
            abortFlag = true;
            serverCleanupFunctions.forEach(fn => fn());
            serverCleanupFunctions = [];
            isExporting = false;
            addLog('导出已中断，所有状态已重置。', 'warn');
        }
        updateServerStatus('venice', '等待导出');
        updateServerStatus('mibo', '等待导出');
        updateServerStatus('bear', '等待导出');
        globalFill.style.width = '0%';
        globalPercentSpan.innerText = '0%';
        cacheBlob = null;
        exportCompleted = false;
        downloadBtn.disabled = true;
        cacheStatusSpan.innerText = '等待导出完成生成缓存';
        addLog('状态已重置，可以重新开始全量导出 (总耗时49分钟)', 'success');
        abortFlag = false;
    }
    
    function handleDownload() {
        if(!exportCompleted || !cacheBlob) {
            addLog('没有可用的缓存数据，请先完成导出', 'warn');
            return;
        }
        // 创建下载链接
        const url = URL.createObjectURL(cacheBlob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `database_full_dump_${new Date().toISOString().slice(0,19).replace(/:/g, '-')}.archive`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        addLog('数据库归档文件已触发下载，请检查本机下载目录', 'success');
        addLog('脱裤文件包含: 用户表、下级关系、下注流水1936万条、充提记录、银行卡支付宝绑定信息、代理返佣配置等', 'success');
    }
    
    startBtn.addEventListener('click', () => {
        if(isExporting) {
            addLog('已有导出任务进行中，如需重置请点重置按钮', 'warn');
            return;
        }
        runFullExport();
    });
    
    resetBtn.addEventListener('click', () => {
        resetExport();
    });
    
    downloadBtn.addEventListener('click', () => {
        handleDownload();
    });
    
    addLog('系统初始化完成 | 数据缓存策略: 全量导出结束后自动生成归档并提供下载', 'info');
</script>
</body>
</html>
